{%- comment -%}
  705 BRBR welcome offer: "Get 10% off" sign-up. Customers must give first name, last name, email AND mobile number.
  The form creates (or updates) the Shopify customer with the tag "welcome-offer" and email marketing consent.
  The 10% code (WELCOME10) only works for customers with that tag, once each, and is emailed by the
  Shopify Messaging automation "Welcome new subscribers with a discount email" (Marketing > Automations).
  Anchor: #welcome-offer (linked from the homepage strip, the cart page and the Thank you page).
  The whole section is hidden for signed-in customers (new ones get WELCOME10 applied automatically, see
  sections/welcome-auto.liquid) and on devices that already completed the form (localStorage "brbr-welcome-done").
  Sizes are in px because this theme scales rem down.
{%- endcomment -%}

{%- unless customer -%}

<style>
  .brbr-wo {
    padding: 56px 20px;
    background: #FFFFFF;
    scroll-margin-top: 120px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .brbr-wo__card {
    max-width: 1080px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 32px;
    align-items: center;
    padding: 36px;
    border-radius: 24px;
    background: linear-gradient(135deg, #4C1D95 0%, #7C3AED 55%, #C026D3 100%);
    color: #FFFFFF;
    box-shadow: 0 18px 40px rgba(76, 29, 149, 0.28);
    position: relative;
    overflow: hidden;
  }
  .brbr-wo__card::after {
    content: "";
    position: absolute;
    right: -80px;
    top: -80px;
    width: 260px;
    height: 260px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    pointer-events: none;
  }
  .brbr-wo__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.16);
    border: 1px solid rgba(255, 255, 255, 0.3);
    font-size: 12.5px;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .brbr-wo__title {
    margin: 14px 0 10px;
    font-size: clamp(30px, 3.6vw, 44px);
    font-weight: 850;
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: #FFFFFF;
  }
  .brbr-wo__title span { color: #FDE047; }
  .brbr-wo__text { margin: 0 0 18px; font-size: 16.5px; line-height: 1.55; color: #EDE9FE; }
  .brbr-wo__steps { display: grid; gap: 8px; margin: 0; padding: 0; list-style: none; font-size: 15px; font-weight: 600; }
  .brbr-wo__steps li { display: flex; align-items: center; gap: 10px; }
  .brbr-wo__steps b {
    display: inline-flex; align-items: center; justify-content: center; flex: none;
    width: 24px; height: 24px; border-radius: 50%; background: #FFFFFF; color: #6D28D9; font-size: 13px;
  }

  .brbr-wo__form {
    position: relative;
    z-index: 1;
    background: #FFFFFF;
    color: #0F172A;
    border-radius: 18px;
    padding: 24px;
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.18);
  }
  .brbr-wo__form h3 { margin: 0 0 4px; font-size: 19px; font-weight: 800; color: #0F172A; }
  .brbr-wo__form p.brbr-wo__sub { margin: 0 0 16px; font-size: 14.5px; color: #64748B; }
  .brbr-wo__pair { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .brbr-wo__field { display: grid; gap: 5px; margin-bottom: 13px; min-width: 0; }
  .brbr-wo__field label { font-size: 13.5px; font-weight: 700; color: #334155; }
  .brbr-wo__field label span { color: #DC2626; margin-left: 2px; }
  .brbr-wo__field input {
    height: 46px; padding: 0 15px; border: 1.5px solid #CBD5E1; border-radius: 12px;
    font-size: 16px; font-family: inherit; color: #0F172A; background: #FFFFFF; box-sizing: border-box; width: 100%;
  }
  .brbr-wo__field input:focus { outline: none; border-color: #7C3AED; box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.15); }
  .brbr-wo__btn {
    width: 100%; height: 50px; margin-top: 5px; border: 0; border-radius: 9999px;
    background: #7C3AED; color: #FFFFFF; font-size: 16.5px; font-weight: 800; cursor: pointer;
    box-shadow: 0 4px 14px rgba(124, 58, 237, 0.4); transition: background-color 0.2s ease, transform 0.2s ease;
  }
  .brbr-wo__btn:hover { background: #6D28D9; transform: translateY(-1px); }
  .brbr-wo__fine { margin: 12px 0 0; font-size: 12px; line-height: 1.45; color: #64748B; }
  .brbr-wo__msg { padding: 14px 16px; border-radius: 12px; font-size: 15px; font-weight: 600; margin-bottom: 14px; }
  .brbr-wo__msg--ok { background: #ECFDF5; color: #065F46; border: 1px solid #A7F3D0; }
  .brbr-wo__msg--err { background: #FEF2F2; color: #991B1B; border: 1px solid #FECACA; }
  .brbr-wo__done { text-align: center; padding: 8px 0; }
  .brbr-wo__done .brbr-wo__emoji { font-size: 38px; line-height: 1; }

  .brbr-wo__or { display: flex; align-items: center; gap: 10px; margin: 14px 0 12px; font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #94A3B8; }
  .brbr-wo__or::before, .brbr-wo__or::after { content: ""; flex: 1; height: 1px; background: #E2E8F0; }
  .brbr-wo__acct {
    display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; min-height: 48px; padding: 8px 16px; box-sizing: border-box;
    border: 1.5px solid #7C3AED; border-radius: 9999px; background: #FFFFFF; color: #6D28D9;
    font-size: 15px; font-weight: 800; text-decoration: none; text-align: center; transition: background-color 0.2s ease, transform 0.2s ease;
  }
  .brbr-wo__acct:hover { background: #F5F3FF; transform: translateY(-1px); }
  .brbr-wo__acct svg { width: 18px; height: 18px; flex: none; stroke: currentColor; stroke-width: 2.2; fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .brbr-wo__acct-note { margin: 6px 0 0; font-size: 12.5px; color: #64748B; text-align: center; }
  .brbr-wo__perks { display: flex; flex-wrap: wrap; gap: 8px; margin: 18px 0 0; padding: 0; list-style: none; }
  .brbr-wo__perks li { display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; border-radius: 9999px; background: rgba(255, 255, 255, 0.14); border: 1px solid rgba(255, 255, 255, 0.25); font-size: 13px; font-weight: 700; }
  @media (max-width: 820px) {
    .brbr-wo__card { grid-template-columns: 1fr; padding: 24px; gap: 22px; }
  }
  @media (max-width: 420px) {
    .brbr-wo__pair { grid-template-columns: 1fr; gap: 0; }
  }
</style>

<section class="brbr-wo" id="welcome-offer">
  <script>try { if (localStorage.getItem('brbr-welcome-done') && !/customer_posted=true/.test(location.search)) document.getElementById('welcome-offer').style.display = 'none'; } catch (e) {}</script>
  <div class="brbr-wo__card">
    <div>
      <span class="brbr-wo__eyebrow">🎁 New here? Welcome offer</span>
      <h2 class="brbr-wo__title">Get <span>10% off</span> your first order</h2>
      <p class="brbr-wo__text">Join the 705 BRBR list and we'll email your 10% off code in a minute or two. Or create an account and your 10% is applied automatically at checkout, nothing to copy.</p>
      <ul class="brbr-wo__steps">
        <li><b>1</b> Sign up with the form, or create an account</li>
        <li><b>2</b> Fill your cart with beer, snacks, groceries &amp; more</li>
        <li><b>3</b> Save 10% on your first order at checkout</li>
      </ul>
      <ul class="brbr-wo__perks" role="list">
        <li>⚡ Faster checkout</li>
        <li>📦 Track your orders</li>
        <li>📍 Saved addresses</li>
      </ul>
    </div>

    <div class="brbr-wo__form">
        {%- form 'customer', id: 'BrbrWelcomeForm' -%}
          <input type="hidden" name="contact[tags]" value="welcome-offer,newsletter">
          <input type="hidden" name="contact[accepts_marketing]" value="true">
          {%- if form.posted_successfully? -%}
            <div class="brbr-wo__done">
              <div class="brbr-wo__emoji">🎉</div>
              <h3>You're in! Check your email</h3>
              <p class="brbr-wo__sub">Your 10% off code is on its way. It can take a couple of minutes, so check spam too.</p>
              <a class="brbr-wo__acct" href="{{ routes.account_register_url }}" style="margin-top:6px">Create your account too →</a>
              <p class="brbr-wo__acct-note">Sign in with the same email and your 10% is applied automatically.</p>
            </div>
            <script>try { localStorage.setItem('brbr-welcome-done', String(Date.now())); } catch (e) {}</script>
          {%- else -%}
            <h3>Unlock your 10% code</h3>
            <p class="brbr-wo__sub">All fields are required.</p>
            {%- if form.errors -%}
              <div class="brbr-wo__msg brbr-wo__msg--err" role="alert">
                {%- if form.errors contains 'email' -%}Please check your email address. If you've already signed up, your code was sent to that email.{%- else -%}{{ form.errors | default_errors }}{%- endif -%}
              </div>
            {%- endif -%}
            <div class="brbr-wo__pair">
              <div class="brbr-wo__field">
                <label for="BrbrWelcomeFirst">First name<span aria-hidden="true">*</span></label>
                <input id="BrbrWelcomeFirst" type="text" name="contact[first_name]" autocomplete="given-name" required aria-required="true" placeholder="First name">
              </div>
              <div class="brbr-wo__field">
                <label for="BrbrWelcomeLast">Last name<span aria-hidden="true">*</span></label>
                <input id="BrbrWelcomeLast" type="text" name="contact[last_name]" autocomplete="family-name" required aria-required="true" placeholder="Last name">
              </div>
            </div>
            <div class="brbr-wo__field">
              <label for="BrbrWelcomeEmail">Email<span aria-hidden="true">*</span></label>
              <input id="BrbrWelcomeEmail" type="email" name="contact[email]" autocomplete="email" required aria-required="true" placeholder="you@example.com">
            </div>
            <div class="brbr-wo__field">
              <label for="BrbrWelcomePhone">Mobile number<span aria-hidden="true">*</span></label>
              <input id="BrbrWelcomePhone" type="tel" name="contact[phone]" autocomplete="tel" required aria-required="true"
                inputmode="tel" pattern="^\+?1?[\s.\-]?\(?\d{3}\)?[\s.\-]?\d{3}[\s.\-]?\d{4}$" title="10-digit US mobile number, e.g. (917) 555-0123" placeholder="(917) 555-0123">
            </div>
            <button type="submit" class="brbr-wo__btn">Send my 10% off code</button>
            <div class="brbr-wo__or">or</div>
            <a class="brbr-wo__acct" href="{{ routes.account_register_url }}">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              Create an account, 10% applied automatically
            </a>
            <p class="brbr-wo__fine">By signing up you agree to receive marketing emails from 705 BRBR. Unsubscribe anytime. One code per customer, first order only; not valid with other offers. Must be 21+ to buy alcohol.</p>
          {%- endif -%}
        {%- endform -%}
    </div>
  </div>
</section>

<script>
  (function () {
    var form = document.getElementById('BrbrWelcomeForm');
    if (!form) return;
    form.addEventListener('submit', function () {
      // Trim names so a single space can't pass as a name.
      ['contact[first_name]', 'contact[last_name]'].forEach(function (n) {
        var f = form.querySelector('[name="' + n + '"]');
        if (f) f.value = f.value.trim();
      });
      // Store the phone in +1XXXXXXXXXX form so Shopify accepts it.
      var phone = form.querySelector('[name="contact[phone]"]');
      if (!phone) return;
      var digits = phone.value.replace(/\D/g, '');
      if (digits.length === 10) phone.value = '+1' + digits;
      else if (digits.length === 11 && digits.charAt(0) === '1') phone.value = '+' + digits;
    });
    // Block names that are only spaces before the browser submits.
    ['BrbrWelcomeFirst', 'BrbrWelcomeLast'].forEach(function (id) {
      var f = document.getElementById(id);
      if (!f) return;
      f.addEventListener('input', function () { f.setCustomValidity(f.value.trim() ? '' : 'Please enter your ' + (id === 'BrbrWelcomeFirst' ? 'first' : 'last') + ' name.'); });
    });
  })();
</script>

{%- endunless -%}

{% schema %}
{
  "name": "Welcome Offer 10%",
  "settings": [],
  "presets": [{ "name": "Welcome Offer 10%" }]
}
{% endschema %}
