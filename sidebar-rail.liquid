</aside>

<script>
  function toggleDoorDashRail(forceState) {
    const rail = document.getElementById('ddSidebarRail');
    const backdrop = document.getElementById('ddRailBackdrop');
    if (!rail) return;

    const shouldExpand = (forceState !== undefined) ? forceState : !rail.classList.contains('is-expanded');

    if (shouldExpand) {
      rail.classList.add('is-expanded');
      if (backdrop) backdrop.classList.add('is-visible');
      document.body.classList.add('overflow-hidden');
    } else {
      rail.classList.remove('is-expanded');
      if (backdrop) backdrop.classList.remove('is-visible');
      document.body.classList.remove('overflow-hidden');
    }
  }

  function setDeptOpen(dept, open) {
    dept.classList.toggle('is-open', open);
    const btn = dept.querySelector(':scope > .dd-rail-btn');
    if (btn) btn.setAttribute('aria-expanded', open ? 'true' : 'false');
  }

  function attachRailBehaviour() {
    const rail = document.getElementById('ddSidebarRail');
    if (!rail || rail.dataset.ready === 'true') return;
    rail.dataset.ready = 'true';

    // Department rows with subcategories open/close their panel instead of navigating.
    rail.querySelectorAll('.dd-dept[data-has-children] > .dd-rail-btn').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        const dept = btn.parentElement;
        const willOpen = !dept.classList.contains('is-open');
        rail.querySelectorAll('.dd-dept.is-open').forEach(function(d) { if (d !== dept) setDeptOpen(d, false); });
        setDeptOpen(dept, willOpen);
      });
    });

    // Delivery button shows the delivery partner list
    const deliveryToggle = rail.querySelector('[data-dd-delivery-toggle]');
    const deliveryPanel = rail.querySelector('#ddDeliveryPanel');
    if (deliveryToggle && deliveryPanel) {
      deliveryToggle.addEventListener('click', function() {
        const open = !deliveryPanel.classList.contains('is-open');
        deliveryPanel.classList.toggle('is-open', open);
        deliveryToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
    }

    // About Us / Contact Us: on the homepage, close the drawer and scroll to that section;
    // on other pages the link opens the homepage at that section.
    rail.querySelectorAll('[data-dd-scroll]').forEach(function(link) {
      link.addEventListener('click', function(e) {
        const target = document.getElementById(link.dataset.ddScroll);
        if (!target) return;
        e.preventDefault();
        toggleDoorDashRail(false);
        setTimeout(function() {
          const startY = window.scrollY;
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          if (history.replaceState) history.replaceState(null, '', '#' + link.dataset.ddScroll);
          // Some browsers ignore smooth scrolling over long distances: jump there if nothing moved.
          setTimeout(function() {
            if (Math.abs(window.scrollY - startY) < 2) target.scrollIntoView({ block: 'start' });
          }, 400);
        }, 150);
      });
    });

    // Close the drawer after choosing a destination
    rail.querySelectorAll('.dd-sub-link, .dd-shop-all, a.dd-quick-btn, .dd-direct-btn, .dd-partner, .dd-footer-btn, .dd-dept:not([data-has-children]) > .dd-rail-btn, .dd-sidebar-rail > a.dd-rail-btn').forEach(function(link) {
      link.addEventListener('click', function() {
        toggleDoorDashRail(false);
      });
    });

    const hamburgerSelectors = [
      '.header__icon--menu',
      'summary.header__icon--menu',
      'header summary.header__icon',
      '.mobile-menu-btn',
      '.mobile-nav-toggle',
      '#menu-toggle'
    ];

    document.querySelectorAll(hamburgerSelectors.join(', ')).forEach(function(btn) {
      if (btn.dataset.railHooked === 'true') return;
      btn.dataset.railHooked = 'true';

      function handleMenuOpen(e) {
        if (window.innerWidth <= 989) {
          e.preventDefault();
          e.stopPropagation();
          e.stopImmediatePropagation();
          toggleDoorDashRail(true);
        }
      }

      btn.addEventListener('click', handleMenuOpen, true);
      btn.addEventListener('touchend', handleMenuOpen, true);
    });
  }

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') toggleDoorDashRail(false);
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', attachRailBehaviour);
  } else {
    attachRailBehaviour();
  }
</script>

