{% comment %}
  Custom 705 BRBR Header: Centered Search Input with Distinct Clear & Shortcut Badges
{% endcomment %}

<style>
  #shopify-section-{{ section.id }} {
    position: fixed !important;
    top: 40px !important;
    left: 0 !important;
    right: 0 !important;
    width: 100% !important;
    height: 64px !important;
    z-index: 990 !important;
  }

  .custom-header-wrapper {
    width: 100%;
    height: 64px;
    background: #FFFFFF;
    border-bottom: 1px solid #E2E8F0;
    padding: 0 2rem;
    font-family: var(--font-body-family, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif);
    box-sizing: border-box;
    display: flex;
    align-items: center;
    position: relative;
  }

  .custom-header-container {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
  }

  .custom-header-left {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-shrink: 0;
  }

  .custom-hamburger-btn {
    background: none;
    border: none;
    padding: 7px;
    margin: 0;
    cursor: pointer;
    color: #191919;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    line-height: 0;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .custom-hamburger-btn:hover {
    background-color: #F1F5F9;
    color: #7C3AED;
  }

  .custom-hamburger-btn svg {
    width: 24px;
    height: 24px;
    stroke: currentColor;
    stroke-width: 2.3;
    stroke-linecap: round;
    fill: none;
    display: block;
  }

  .custom-brand-group {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    text-decoration: none;
    color: inherit;
  }

  .custom-brand-logo {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid #7C3AED;
    display: block;
  }

  .custom-brand-text {
    display: flex;
    flex-direction: column;
  }

  .custom-brand-name {
    font-size: 1.35rem;
    font-weight: 850;
    color: #0F172A;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .custom-brand-tagline {
    font-size: 0.78rem;
    font-weight: 800;
    color: #7C3AED;
    text-transform: uppercase;
    letter-spacing: 0.6px;
  }

  /* Center Search Container */
  .custom-search-container {
    flex: 1;
    max-width: 620px;
    min-width: 240px;
    position: relative;
  }

  .custom-search-form {
    position: relative;
    width: 100%;
    margin: 0;
  }

  .custom-search-inner {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
  }

  .custom-search-icon-btn {
    position: absolute;
    left: 18px;
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #475569;
    pointer-events: none;
    z-index: 2;
  }

  .custom-search-icon-btn svg {
    width: 20px;
    height: 20px;
    stroke: currentColor;
    stroke-width: 2.2;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Centered Search Input */
  .custom-search-input {
    width: 100%;
    height: 46px;
    padding: 0 5.5rem 0 3.5rem; /* Symmetrical padding so text stays visually centered */
    background-color: #F1F5F9;
    border: 2px solid transparent;
    border-radius: 9999px;
    font-size: 1.05rem;
    font-weight: 600;
    font-family: inherit;
    color: #0F172A;
    text-align: center; /* Centered input text */
    outline: none;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    box-sizing: border-box;
  }

  /* Turn off colliding native browser cancel button */
  .custom-search-input::-webkit-search-cancel-button,
  .custom-search-input::-webkit-search-decoration,
  .custom-search-input::-webkit-search-results-button,
  .custom-search-input::-webkit-search-results-decoration {
    -webkit-appearance: none;
    appearance: none;
    display: none !important;
  }

  .custom-search-input::placeholder {
    color: #64748B;
    font-weight: 500;
    text-align: center;
  }

  .custom-search-input:hover {
    background-color: #E2E8F0;
  }

  .custom-search-input:focus {
    background-color: #FFFFFF;
    border-color: #7C3AED;
    box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.15);
  }

  /* Dedicated Right Actions Container (X Button + Shortcut Badge) */
  .custom-search-actions {
    position: absolute;
    right: 14px;
    display: flex;
    align-items: center;
    gap: 8px;
    z-index: 3;
    pointer-events: auto;
  }

  /* Standalone Custom Cancel Button */
  .custom-search-clear-btn {
    background: #E2E8F0;
    border: none;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    display: none; /* Toggled cleanly via JavaScript */
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #475569;
    padding: 0;
    transition: all 0.15s ease;
    flex-shrink: 0;
  }

  .custom-search-clear-btn:hover {
    background: #CBD5E1;
    color: #0F172A;
    transform: scale(1.05);
  }

  .custom-search-clear-btn svg {
    width: 13px;
    height: 13px;
    stroke: currentColor;
    stroke-width: 2.5;
    fill: none;
  }

  /* Shortcut Hint Badge */
  .custom-search-kbd {
    font-size: 0.8rem;
    font-weight: 700;
    color: #475569;
    background: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 3px 8px;
    pointer-events: none;
    line-height: 1.2;
    display: inline-flex;
    align-items: center;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
    flex-shrink: 0;
  }

  /* Enhanced Live Predictive Dropdown */
  .custom-search-dropdown {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    background: #FFFFFF;
    border-radius: 16px;
    border: 1px solid #CBD5E1;
    box-shadow: 0 14px 34px rgba(15, 23, 42, 0.15);
    max-height: 480px;
    overflow-y: auto;
    display: none;
    z-index: 1000;
    padding: 0.85rem;
    box-sizing: border-box;
  }

  .custom-search-result-item {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    padding: 0.85rem 1rem;
    border-radius: 12px;
    text-decoration: none;
    color: #0F172A;
    border-bottom: 1px solid #F1F5F9;
    transition: background-color 0.15s ease, transform 0.15s ease;
  }

  .custom-search-result-item:last-child {
    border-bottom: none;
  }

  .custom-search-result-item:hover {
    background-color: #F8FAFC;
    transform: translateX(3px);
  }

  .custom-search-result-thumb {
    width: 56px;
    height: 56px;
    border-radius: 10px;
    object-fit: contain;
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    padding: 4px;
    flex-shrink: 0;
  }

  .custom-search-result-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
    overflow: hidden;
    flex: 1;
  }

  .custom-search-result-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: #0F172A;
    line-height: 1.35;
    white-space: normal;
    word-break: break-word;
  }

  .custom-search-result-price {
    font-size: 1rem;
    color: #7C3AED;
    font-weight: 800;
  }

  .custom-search-result-thumb--empty {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #7C3AED;
    background: #F5F3FF;
    box-sizing: border-box;
  }

  .custom-search-result-thumb--empty svg {
    width: 26px;
    height: 26px;
  }

  .custom-search-dym {
    display: block;
    margin: 0 0 6px;
    padding: 10px 14px;
    border-radius: 10px;
    background: #F5F3FF;
    color: #1F2937;
    font-size: 15px;
    line-height: 1.4;
    text-decoration: none;
  }

  .custom-search-dym strong {
    color: #6D28D9;
  }

  .custom-search-dym:hover {
    background: #EDE9FE;
  }

  .custom-search-footer-link {
    border-top: 1px solid #E2E8F0;
    margin-top: 10px;
    padding-top: 10px;
    text-align: center;
  }

  .custom-search-footer-link a {
    font-size: 0.95rem;
    font-weight: 800;
    color: #7C3AED;
    text-decoration: none;
    display: inline-block;
    padding: 6px 12px;
  }

  .custom-search-footer-link a:hover {
    text-decoration: underline;
  }

  /* Right Icons */
  .custom-shop-icons {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-shrink: 0;
  }

  .shop-icon-link {
    color: #1E293B;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .shop-icon-link:hover {
    color: #7C3AED;
    background-color: #F8FAFC;
    transform: translateY(-1px);
  }

  .shop-icon-link svg {
    width: 22px;
    height: 22px;
    stroke: currentColor;
    stroke-width: 2;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .mobile-search-toggle {
    display: none;
  }

  /* Sign in / Sign up */
  .custom-auth-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 38px;
    padding: 0 14px;
    border-radius: 9999px;
    font-size: 14px;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .custom-auth-btn--ghost {
    color: #1E293B;
  }

  .custom-auth-btn--ghost:hover {
    color: #7C3AED;
    background-color: #F5F3FF;
  }

  .custom-auth-btn--outline {
    color: #7C3AED;
    border: 1.5px solid #7C3AED;
    background-color: #FFFFFF;
  }

  .custom-auth-btn--outline:hover {
    background-color: #F5F3FF;
    transform: translateY(-1px);
  }

  .custom-auth-btn--name {
    gap: 6px;
    max-width: 160px;
  }

  .custom-auth-btn--name span {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .custom-auth-btn--name svg {
    width: 16px;
    height: 16px;
    flex: none;
    stroke: currentColor;
    stroke-width: 2;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Account dropdown (signed-in customers) */
  .custom-account-menu {
    position: relative;
  }

  .custom-account-menu > summary {
    list-style: none;
    cursor: pointer;
  }

  .custom-account-menu > summary::-webkit-details-marker {
    display: none;
  }

  .custom-auth-btn--name .custom-account-chevron {
    width: 14px;
    height: 14px;
    transition: transform 0.2s ease;
  }

  .custom-account-menu[open] .custom-account-chevron {
    transform: rotate(180deg);
  }

  .custom-account-menu[open] > summary {
    background-color: #F5F3FF;
  }

  .custom-account-dropdown {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    min-width: 230px;
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 14px;
    box-shadow: 0 14px 34px rgba(15, 23, 42, 0.15);
    padding: 6px;
    z-index: 1001;
  }

  .custom-account-head {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px 12px 12px;
    border-bottom: 1px solid #F1F5F9;
    margin-bottom: 4px;
  }

  .custom-account-head strong {
    font-size: 15px;
    font-weight: 800;
    color: #0F172A;
  }

  .custom-account-head span {
    font-size: 13px;
    color: #64748B;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .custom-account-dropdown a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-radius: 10px;
    font-size: 15px;
    font-weight: 600;
    color: #1E293B;
    text-decoration: none;
  }

  .custom-account-dropdown a:hover {
    background: #F5F3FF;
    color: #7C3AED;
  }

  .custom-account-dropdown a svg {
    width: 18px;
    height: 18px;
    flex: none;
    stroke: currentColor;
    stroke-width: 2;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .custom-account-dropdown a.custom-account-signout {
    border-top: 1px solid #F1F5F9;
    border-radius: 0 0 10px 10px;
    margin-top: 4px;
    color: #B91C1C;
  }

  .custom-account-dropdown a.custom-account-signout:hover {
    background: #FEF2F2;
    color: #B91C1C;
  }

  .custom-shop-icons .custom-auth-btn + .custom-auth-btn {
    margin-left: -0.45rem;
  }

  @media (max-width: 520px) {
    .custom-auth-btn--signup { display: none; }
    .custom-auth-btn { height: 34px; padding: 0 10px; font-size: 13px; }
    .custom-auth-btn--name { max-width: 110px; }
  }

  .custom-cart-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    background-color: #7C3AED;
    color: #FFFFFF;
    text-decoration: none;
    padding: 0.5rem 1.1rem;
    border-radius: 9999px;
    font-weight: 800;
    font-size: 1rem;
    line-height: 1;
    box-shadow: 0 2px 8px rgba(124, 58, 237, 0.35);
    transition: all 0.2s ease;
  }

  .custom-cart-pill:hover {
    background-color: #6D28D9;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(124, 58, 237, 0.45);
  }

  .custom-cart-pill svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  .cart-pill-count {
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 860px) {
    .custom-search-container {
      display: none;
    }
    .mobile-search-toggle {
      display: inline-flex;
    }
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      top: 36px !important;
      height: 56px !important;
    }
    .custom-header-wrapper {
      height: 56px;
      padding: 0 1rem;
    }
    .custom-brand-name {
      font-size: 1.18rem;
    }
    .custom-brand-tagline {
      display: none;
    }
    .custom-shop-icons {
      gap: 0.45rem;
    }
    .custom-cart-pill {
      padding: 0.42rem 0.85rem;
      font-size: 0.9rem;
    }
  }
</style>

<header class="custom-header-wrapper">
  <div class="custom-header-container">
    <div class="custom-header-left">
      <button 
        type="button" 
        class="custom-hamburger-btn"
        onclick="toggleDoorDashRail()" 
        aria-label="Toggle Menu"
      >
        <svg viewBox="0 0 24 24">
          <line x1="3" y1="5" x2="21" y2="5"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="19" x2="21" y2="19"></line>
        </svg>
      </button>

      <a href="/" class="custom-brand-group">
        {% if section.settings.logo != blank %}
          <img src="{{ section.settings.logo | image_url: width: 140 }}" alt="{{ shop.name }}" class="custom-brand-logo" />
        {% else %}
          <div class="custom-brand-logo" style="background:#7C3AED; display:flex; align-items:center; justify-content:center; color:#fff; font-weight:bold; font-size:1rem;">705</div>
        {% endif %}
        <div class="custom-brand-text">
          <span class="custom-brand-name">705 BRBR</span>
          <span class="custom-brand-tagline">Beer • Groceries • Pet</span>
        </div>
      </a>
    </div>

    <!-- Center Search Bar with Dropdown Container -->
    <div class="custom-search-container">
      <form action="{{ routes.search_url }}" method="get" role="search" class="custom-search-form">
        <div class="custom-search-inner">
          <span class="custom-search-icon-btn">
            <svg viewBox="0 0 24 24">
              <circle cx="11" cy="11" r="7"></circle>
              <path d="m20 20-3.5-3.5"></path>
            </svg>
          </span>
          <input 
            type="search" 
            name="q" 
            id="centerSearchInput"
            value="{{ search.terms | escape }}" 
            placeholder="Search 705 BRBR – Beer, Groceries, Pet..."
            class="custom-search-input"
            autocomplete="off"
            aria-label="Search items"
          >
          <input type="hidden" name="options[prefix]" value="last">
          
          <!-- Actions Container with Distinct Clear & Kbd Badges -->
          <div class="custom-search-actions">
            <button type="button" id="clearSearchBtn" class="custom-search-clear-btn" aria-label="Clear search">
              <svg viewBox="0 0 24 24">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
            <span class="custom-search-kbd">⌘K</span>
          </div>
        </div>
      </form>

      <!-- Dropdown for Live Results & Graceful Outage Fallback -->
      <div id="searchResultsDropdown" class="custom-search-dropdown" role="region" aria-live="polite"></div>
    </div>

    <!-- Right Icons -->
    <div class="custom-shop-icons">
      <a href="{{ routes.search_url }}" class="shop-icon-link mobile-search-toggle" title="Search store" aria-label="Search">
        <svg viewBox="0 0 24 24">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
      </a>

      {%- if customer -%}
        {%- assign account_base = 'https://shopify.com/' | append: shop.id | append: '/account' -%}
        <details class="custom-account-menu">
          <summary class="custom-auth-btn custom-auth-btn--outline custom-auth-btn--name" title="My account">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            <span>{% if customer.first_name != blank %}{{ customer.first_name | escape }}{% else %}My account{% endif %}</span>
            <svg class="custom-account-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
          </summary>
          <div class="custom-account-dropdown" role="menu">
            <div class="custom-account-head">
              <strong>{% if customer.name != blank %}{{ customer.name | escape }}{% else %}My account{% endif %}</strong>
              {%- if customer.email != blank -%}<span>{{ customer.email | escape }}</span>{%- endif -%}
            </div>
            <a href="{{ account_base }}/profile" role="menuitem">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
              Profile
            </a>
            <a href="{{ account_base }}/orders" role="menuitem">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><path d="M3 6h18"></path><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
              Orders
            </a>
            <a href="{{ routes.account_logout_url }}" role="menuitem" class="custom-account-signout">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><path d="m16 17 5-5-5-5"></path><path d="M21 12H9"></path></svg>
              Sign out
            </a>
          </div>
        </details>
      {%- else -%}
        <a href="{{ routes.account_login_url }}" class="custom-auth-btn custom-auth-btn--ghost">Sign in</a>
        <a href="/pages/sign-up" class="custom-auth-btn custom-auth-btn--outline custom-auth-btn--signup">Sign up</a>
      {%- endif -%}

      <a href="{{ routes.cart_url }}" class="custom-cart-pill" title="Shopping Cart" aria-label="Cart">
        <svg viewBox="0 0 24 24">
          <path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"/>
        </svg>
        <span class="cart-pill-count">{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

<script src="{{ 'brbr-smart-search.js' | asset_url }}" defer></script>
<script>
  let searchDebounceTimer = null;

  // Keyboard shortcut listener for Ctrl+K / Cmd+K
  document.addEventListener('keydown', function(e) {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      const searchInput = document.getElementById('centerSearchInput');
      if (searchInput) {
        searchInput.focus();
        searchInput.select();
      }
    }
  });

  (function updateKeyboardHint() {
    const kbd = document.querySelector('.custom-search-kbd');
    if (kbd && navigator.platform && !navigator.platform.toUpperCase().includes('MAC')) {
      kbd.textContent = 'Ctrl K';
    }
  })();

  // Live search: Shopify suggestions + 705 BRBR smart (typo-tolerant) matches
  let latestSearchQuery = '';
  function searchThumb(src, title) {
    if (!src) {
      return `<span class="custom-search-result-thumb custom-search-result-thumb--empty" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8.5A2.5 2.5 0 0 1 5.5 6h1.8l1.4-2h6.6l1.4 2h1.8A2.5 2.5 0 0 1 21 8.5v9a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 17.5z"/><circle cx="12" cy="12.5" r="3.6"/></svg></span>`;
    }
    return `<img src="${src}" alt="${escapeHtml(title)}" class="custom-search-result-thumb" loading="lazy">`;
  }

  function searchUrl(q, original) {
    let url = `{{ routes.search_url }}?q=${encodeURIComponent(q)}`;
    if (original) url += `&oq=${encodeURIComponent(original)}`;
    return url;
  }

  async function fetchLiveSearchResults(query) {
    const dropdown = document.getElementById('searchResultsDropdown');
    if (!dropdown) return;
    latestSearchQuery = query;

    if (!query || query.trim().length < 2) {
      dropdown.style.display = 'none';
      dropdown.innerHTML = '';
      return;
    }

    const smart = window.BRBRSearch;
    const smartPromise = smart
      ? smart.load().then(() => smart.search(query, 6)).catch(() => null)
      : Promise.resolve(null);

    let products = [];
    let suggestFailed = false;
    try {
      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), 4000);
      const endpoint = `${window.Shopify ? window.Shopify.routes.root : '/'}search/suggest.json?q=${encodeURIComponent(query)}&resources[type]=product&resources[limit]=6&resources[options][unavailable_products]=last`;
      const response = await fetch(endpoint, { signal: controller.signal });
      clearTimeout(timeoutId);
      if (!response.ok) throw new Error(`HTTP Error: ${response.status}`);
      const data = await response.json();
      products = data.resources && data.resources.results && data.resources.results.products ? data.resources.results.products : [];
    } catch (err) {
      suggestFailed = true;
      console.warn('Shopify Predictive Search unavailable, using smart search only:', err);
    }

    const smartRes = await smartPromise;
    if (query !== latestSearchQuery) return; // a newer search is already running

    // Normal spelling: Shopify matches first, then smart matches.
    // Misspelled word: smart (corrected) matches first. No duplicates, 6 results max.
    const corrected = smartRes && smartRes.corrected ? smartRes.corrected : null;
    const seen = {};
    const list = [];
    const addShopify = () => products.forEach(p => {
      const key = (p.url || '').split('?')[0];
      if (list.length >= 6 || seen[key]) return;
      seen[key] = 1;
      list.push({ title: p.title, url: p.url, image: p.image, price: p.price });
    });
    const addSmart = () => smartRes && smartRes.results.forEach(p => {
      if (list.length >= 6 || seen[p.url]) return;
      seen[p.url] = 1;
      list.push(p);
    });
    if (corrected) { addSmart(); addShopify(); } else { addShopify(); addSmart(); }

    if (list.length === 0 && suggestFailed && !smartRes) {
      dropdown.innerHTML = `
        <div style="padding: 1.5rem; text-align: center; font-size: 0.95rem;">
          <p style="margin: 0 0 0.45rem; font-weight: 800; color: #0F172A; font-size: 1.1rem;">
            Store catalog is momentarily syncing
          </p>
          <p style="margin: 0 0 1rem; font-size: 0.92rem; color: #334155; line-height: 1.5;">
            You can browse primary aisles directly or check real-time stock on DoorDash:
          </p>
          <div style="display: flex; gap: 0.5rem; justify-content: center; flex-wrap: wrap; margin-bottom: 1rem;">
            <a href="/collections/all-beer" style="background:#EDE9FE; color:#7C3AED; padding:6px 12px; border-radius:6px; text-decoration:none; font-weight:700; font-size:0.88rem;">Beer</a>
            <a href="/collections/all-seltzer" style="background:#EDE9FE; color:#7C3AED; padding:6px 12px; border-radius:6px; text-decoration:none; font-weight:700; font-size:0.88rem;">Seltzers</a>
            <a href="/collections/grocery" style="background:#EDE9FE; color:#7C3AED; padding:6px 12px; border-radius:6px; text-decoration:none; font-weight:700; font-size:0.88rem;">Grocery</a>
            <a href="/collections/snacks" style="background:#EDE9FE; color:#7C3AED; padding:6px 12px; border-radius:6px; text-decoration:none; font-weight:700; font-size:0.88rem;">Snacks</a>
            <a href="/collections/pet-care" style="background:#EDE9FE; color:#7C3AED; padding:6px 12px; border-radius:6px; text-decoration:none; font-weight:700; font-size:0.88rem;">Pet Care</a>
          </div>
          <a href="https://www.doordash.com/store/705-brbr-new-york-26214688/" target="_blank" rel="noopener" style="display:inline-block; background:#FF3008; color:#FFFFFF; padding:7px 15px; border-radius:6px; text-decoration:none; font-weight:800; font-size:0.9rem;">
            Open Live DoorDash Menu &rarr;
          </a>
        </div>
      `;
      dropdown.style.display = 'block';
      return;
    }

    if (list.length === 0) {
      dropdown.innerHTML = `
        <div style="padding: 1.5rem 1rem; text-align: center; color: #1E293B; font-size: 1rem;">
          No items matching "<strong>${escapeHtml(query)}</strong>".
          <div style="margin-top: 0.85rem;">
            <a href="${searchUrl(query)}" style="color: #7C3AED; font-weight: 700; text-decoration: none; font-size: 0.95rem;">View all search results &rarr;</a>
          </div>
        </div>
      `;
      dropdown.style.display = 'block';
      return;
    }

    const didYouMean = corrected
      ? `<a href="${searchUrl(corrected, query)}" class="custom-search-dym">Did you mean <strong>${escapeHtml(corrected)}</strong>?</a>`
      : '';

    dropdown.innerHTML = didYouMean + list.map(prod => `
      <a href="${prod.url}" class="custom-search-result-item">
        ${searchThumb(prod.image, prod.title)}
        <div class="custom-search-result-info">
          <span class="custom-search-result-title">${escapeHtml(prod.title)}</span>
          <span class="custom-search-result-price">${prod.price ? '$' + (parseFloat(prod.price)).toFixed(2) : ''}</span>
        </div>
      </a>
    `).join('') + `
      <div class="custom-search-footer-link">
        <a href="${corrected ? searchUrl(corrected, query) : searchUrl(query)}">
          See all results for "${escapeHtml(corrected || query)}" &rarr;
        </a>
      </div>
    `;
    dropdown.style.display = 'block';
  }

  function escapeHtml(text) {
    if (!text) return '';
    return text.replace(/[&<>"']/g, function(m) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m];
    });
  }

  // Account dropdown: close when clicking elsewhere or pressing Escape
  document.addEventListener('click', function(e) {
    document.querySelectorAll('.custom-account-menu[open]').forEach(function(menu) {
      if (!menu.contains(e.target)) menu.removeAttribute('open');
    });
  });
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      document.querySelectorAll('.custom-account-menu[open]').forEach(function(menu) { menu.removeAttribute('open'); });
    }
  });

  document.addEventListener('DOMContentLoaded', function() {
    const input = document.getElementById('centerSearchInput');
    const dropdown = document.getElementById('searchResultsDropdown');
    const clearBtn = document.getElementById('clearSearchBtn');

    function toggleClearButton() {
      if (!clearBtn || !input) return;
      if (input.value.trim().length > 0) {
        clearBtn.style.display = 'inline-flex';
      } else {
        clearBtn.style.display = 'none';
      }
    }

    if (input) {
      toggleClearButton();
      input.addEventListener('focus', function() {
        if (window.BRBRSearch) window.BRBRSearch.load().catch(function() {});
      });

      input.addEventListener('input', function() {
        toggleClearButton();
        clearTimeout(searchDebounceTimer);
        const query = this.value;
        searchDebounceTimer = setTimeout(() => {
          fetchLiveSearchResults(query);
        }, 250);
      });

      if (clearBtn) {
        clearBtn.addEventListener('click', function() {
          input.value = '';
          toggleClearButton();
          if (dropdown) {
            dropdown.style.display = 'none';
            dropdown.innerHTML = '';
          }
          input.focus();
        });
      }

      document.addEventListener('click', function(e) {
        if (!e.target.closest('.custom-search-container')) {
          if (dropdown) dropdown.style.display = 'none';
        }
      });
    }
  });
</script>

