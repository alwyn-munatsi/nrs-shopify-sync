{%- comment -%}
  705 BRBR: welcome offer for signed-in customers.
  When a customer is signed in and has no orders yet, the 10% welcome code (WELCOME10) is applied to their cart
  automatically, so it shows at checkout with nothing to copy. The first time, a small "Welcome, your 10% is applied"
  message pops up. Eligibility (Discounts > WELCOME10) is the segment "customers tagged welcome-offer OR with 0 orders",
  once per customer, so it stops after the first order.
  The homepage sign-up strip and section are hidden for signed-in customers.
  Sizes in px because this theme scales rem down.
{%- endcomment -%}

{%- if section.settings.enabled and customer and customer.orders_count == 0 -%}
<style>
  .brbr-wtoast {
    position: fixed; left: 20px; bottom: 20px; z-index: 1004; width: 360px; max-width: calc(100vw - 32px);
    display: flex; gap: 12px; align-items: flex-start; padding: 16px 16px 16px 14px; box-sizing: border-box; border-radius: 18px;
    background: radial-gradient(120% 120% at 0% 0%, #6D28D9 0%, #4C1D95 55%, #2E1065 100%); color: #FFFFFF;
    box-shadow: 0 24px 50px -18px rgba(46, 16, 101, 0.75); font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    opacity: 0; transform: translateY(16px); transition: opacity 0.3s ease, transform 0.35s cubic-bezier(.2,.8,.2,1); pointer-events: none;
  }
  .brbr-wtoast.is-on { opacity: 1; transform: none; pointer-events: auto; }
  .brbr-wtoast__emoji { flex: none; display: inline-flex; align-items: center; justify-content: center; width: 42px; height: 42px; border-radius: 12px; background: rgba(255, 255, 255, 0.14); font-size: 22px; }
  .brbr-wtoast__body { flex: 1; min-width: 0; }
  .brbr-wtoast__title { margin: 1px 0 3px; font-size: 16px; font-weight: 800; letter-spacing: -0.01em; color: #FFFFFF; }
  .brbr-wtoast__text { margin: 0; font-size: 13.5px; line-height: 1.45; color: #EDE9FE; }
  .brbr-wtoast__code { display: inline-block; margin-top: 8px; padding: 3px 9px; border-radius: 8px; border: 1px dashed rgba(253, 224, 71, 0.7); color: #FDE047; font-size: 12.5px; font-weight: 800; letter-spacing: 0.06em; }
  .brbr-wtoast__close { flex: none; width: 28px; height: 28px; border: 0; border-radius: 50%; background: rgba(255, 255, 255, 0.12); color: #FFFFFF; font-size: 16px; line-height: 1; cursor: pointer; }
  .brbr-wtoast__close:hover { background: rgba(255, 255, 255, 0.22); }
  @media (max-width: 600px) { .brbr-wtoast { left: 16px; bottom: 84px; } }
  @media (prefers-reduced-motion: reduce) { .brbr-wtoast { transition: none; } }
</style>

<div class="brbr-wtoast" id="brbrWelcomeToast" role="status" aria-live="polite" hidden>
  <span class="brbr-wtoast__emoji" aria-hidden="true">🎉</span>
  <div class="brbr-wtoast__body">
    <p class="brbr-wtoast__title">Welcome{% if customer.first_name != blank %}, {{ customer.first_name | escape }}{% endif %}!</p>
    <p class="brbr-wtoast__text">Your 10% off is applied to your first order. You'll see it at checkout.</p>
    <span class="brbr-wtoast__code">{{ section.settings.code | escape }} · APPLIED</span>
  </div>
  <button type="button" class="brbr-wtoast__close" aria-label="Close">×</button>
</div>

<script>
  (function () {
    var CODE = {{ section.settings.code | json }};
    var CUSTOMER = {{ customer.id | json }};
    var SEEN_KEY = 'brbr-welcome-toast-' + CUSTOMER;
    var toast = document.getElementById('brbrWelcomeToast');
    if (!CODE || !toast) return;
    if (toast.parentNode !== document.body) document.body.appendChild(toast);
    try { localStorage.setItem('brbr-welcome-done', String(Date.now())); } catch (e) {}

    var nf = window.fetch.bind(window);
    function cart() { return nf('/cart.js', { headers: { Accept: 'application/json' }, credentials: 'same-origin' }).then(function (r) { return r.json(); }); }
    function hasCode(c) { return (c.discount_codes || []).some(function (d) { return String(d.code).toUpperCase() === CODE.toUpperCase(); }); }
    function apply() {
      return nf('/cart/update.js', {
        method: 'POST', credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ discount: CODE })
      }).catch(function () {});
    }
    function showToast() {
      var seen = false;
      try { seen = !!localStorage.getItem(SEEN_KEY); } catch (e) {}
      if (seen) return;
      toast.hidden = false;
      requestAnimationFrame(function () { toast.classList.add('is-on'); });
      var t = setTimeout(hide, 9000);
      function hide() { clearTimeout(t); toast.classList.remove('is-on'); setTimeout(function () { toast.hidden = true; }, 350); }
      toast.querySelector('.brbr-wtoast__close').addEventListener('click', hide);
      try { localStorage.setItem(SEEN_KEY, '1'); } catch (e) {}
    }
    function ensure() { return cart().then(function (c) { if (!hasCode(c)) return apply(); }).catch(function () {}); }

    // Apply now, and again whenever the cart changes (adding the first item, or after the cart is cleared)
    ensure().then(function () { setTimeout(showToast, 900); });
    var busy = false;
    function onCart(e) {
      var c = e && e.detail;
      if (busy || !c || hasCode(c)) return;
      busy = true; apply().then(function () { busy = false; });
    }
    document.addEventListener('brbr:cart-synced', onCart);
    document.addEventListener('brbr:cart-updated', onCart);
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Welcome Auto-Apply",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Apply the welcome code automatically for new signed-in customers", "default": true },
    { "type": "text", "id": "code", "label": "Discount code", "default": "WELCOME10" }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
