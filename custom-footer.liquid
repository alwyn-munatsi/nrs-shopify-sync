{% comment %}
  705 BRBR Dark Branded Footer with Social Pills, Operating Info, Dual Maps & Legal Verification
  Layout: Far Left, Center, and Far Right Distribution with Increased Typography Scale
{% endcomment %}

<style>
  .custom-footer-wrapper {
    background-color: #070B14;
    color: #94A3B8;
    padding: 4rem 2.5rem 2.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-family: var(--font-body-family, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif);
    box-sizing: border-box;
    position: relative;
    z-index: 10;
    width: 100%;
  }

  /* Distributed Layout: Far Left, Center, Far Right */
  .custom-footer-container {
    width: 100%;
    max-width: 100%;
    margin: 0;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 3rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    box-sizing: border-box;
  }

  /* Column 1: Far Left */
  .footer-col-left {
    flex: 0 1 370px;
    text-align: left;
  }

  /* Column 2: Exact Center */
  .footer-col-center {
    flex: 0 1 420px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin: 0 auto;
  }

  /* Column 3: Far Right */
  .footer-col-right {
    flex: 0 1 370px;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
  }

  .footer-col-heading {
    color: #FFFFFF;
    font-family: inherit;
    line-height: 1.3;
    font-size: 1.15rem; /* Increased from 0.95rem */
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0 0 1.35rem;
    position: relative;
    display: inline-block;
  }

  .footer-col-heading::after {
    content: '';
    display: block;
    width: 28px;
    height: 3px;
    background-color: #7C3AED;
    margin-top: 8px;
    border-radius: 2px;
  }

  .footer-col-center .footer-col-heading::after {
    margin-left: auto;
    margin-right: auto;
  }

  .footer-col-right .footer-col-heading::after {
    margin-left: auto;
  }

  /* Brand and Contact */
  .footer-brand-header {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    margin-bottom: 1.4rem;
  }

  .footer-logo-badge {
    width: 52px; /* Increased from 46px */
    height: 52px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid #7C3AED;
    display: block;
    flex-shrink: 0;
  }

  .footer-brand-title {
    color: #FFFFFF;
    font-size: 1.4rem; /* Increased from 1.25rem */
    font-weight: 800;
    margin: 0 0 0.25rem;
    letter-spacing: -0.01em;
  }

  .footer-brand-tagline {
    font-size: 0.85rem; /* Increased from 0.75rem */
    color: #A78BFA;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    margin: 0;
  }

  .footer-contact-details {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    font-size: 0.98rem; /* Increased from 0.86rem */
  }

  .footer-contact-details li {
    display: flex;
    align-items: flex-start;
    gap: 0.8rem;
    line-height: 1.5;
  }

  .footer-contact-icon {
    width: 20px; /* Increased from 17px */
    height: 20px;
    color: #7C3AED;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .footer-contact-details a {
    color: #CBD5E1;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-contact-details a:hover {
    color: #FFFFFF;
    text-decoration: underline;
  }

  /* Operating Hours Card */
  .footer-hours-box {
    width: 100%;
    background: #0B1120;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 1.15rem 1.35rem;
    margin-bottom: 1.75rem;
    box-sizing: border-box;
  }

  .footer-hours-line {
    display: flex;
    justify-content: space-between;
    gap: 1.75rem;
    font-size: 0.95rem; /* Increased from 0.84rem */
    padding: 0.55rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .footer-hours-line:last-child {
    border-bottom: none;
  }

  .footer-hours-line span:first-child {
    color: #E2E8F0;
    font-weight: 500;
  }

  .footer-hours-line span:last-child {
    color: #34D399;
    font-weight: 700;
  }

  /* Social Media Pills */
  .footer-social-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.65rem;
    width: 100%;
  }

  .footer-pill-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    background: #111827;
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #E2E8F0;
    text-decoration: none;
    padding: 0.55rem 1rem;
    border-radius: 8px;
    font-size: 0.92rem; /* Increased from 0.82rem */
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .footer-pill-btn:hover {
    background: #1E293B;
    border-color: #7C3AED;
    color: #FFFFFF;
    transform: translateY(-2px);
  }

  .footer-pill-btn svg {
    width: 17px;
    height: 17px;
    fill: currentColor;
    flex-shrink: 0;
  }

  /* Embedded Map Section */
  .footer-map-frame {
    width: 100%;
    height: 180px;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    margin-bottom: 1rem;
    background: #0B1120;
  }

  .footer-map-frame iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  /* Dual Map Action Buttons */
  .footer-maps-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.65rem;
    width: 100%;
  }

  .footer-maps-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 0.68rem 0.85rem;
    border-radius: 8px;
    background: #111827;
    color: #FFFFFF;
    font-size: 0.9rem; /* Increased from 0.8rem */
    font-weight: 600;
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.12);
    transition: all 0.2s ease;
    box-sizing: border-box;
    white-space: nowrap;
  }

  .footer-maps-action:hover {
    border-color: #7C3AED;
    background: #1E293B;
    transform: translateY(-1px);
  }

  #store-location { scroll-margin-top: 120px; }

  .footer-maps-action.apple:hover {
    border-color: #A78BFA;
  }

  .footer-maps-action svg {
    width: 17px;
    height: 17px;
    fill: currentColor;
    flex-shrink: 0;
  }

  /* Bottom Row: Legal & Policies */
  .footer-bottom-legal {
    width: 100%;
    margin: 2rem 0 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.25rem;
    font-size: 0.88rem; /* Increased from 0.775rem */
    color: #94A3B8;
  }

  .footer-policy-row {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .footer-policy-row a {
    color: #94A3B8;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-policy-row a:hover {
    color: #FFFFFF;
    text-decoration: underline;
  }

  /* Responsive Adjustments */
  @media (max-width: 1024px) {
    .custom-footer-container {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
    .footer-col-right {
      grid-column: span 2;
      align-items: flex-start;
      text-align: left;
    }
    .footer-col-right .footer-col-heading::after {
      margin-left: 0;
    }
  }

  @media (max-width: 768px) {
    .custom-footer-wrapper {
      padding: 3rem 1.25rem 5.5rem;
      margin-left: 0;
      width: 100%;
    }
    .custom-footer-container {
      display: flex;
      flex-direction: column;
      gap: 2.25rem;
    }
    .footer-col-left,
    .footer-col-center,
    .footer-col-right {
      flex: 1 1 100%;
      width: 100%;
      align-items: flex-start;
      text-align: left;
      margin: 0;
    }
    .footer-col-center .footer-col-heading::after,
    .footer-col-right .footer-col-heading::after {
      margin-left: 0;
      margin-right: 0;
    }
    .footer-social-grid {
      justify-content: flex-start;
    }
    .footer-bottom-legal {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
  }
</style>

