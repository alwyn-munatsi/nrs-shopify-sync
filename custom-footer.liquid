    if (!/iPhone|iPad|iPod|Macintosh/.test(navigator.userAgent)) return;
    document.querySelectorAll('[data-apple-maps]').forEach(function (a) {
      a.setAttribute('href', 'maps://?q=705+BRBR&address=705+2nd+Ave,+New+York,+NY+10016');
      a.removeAttribute('target');
    });
  })();
</script>

