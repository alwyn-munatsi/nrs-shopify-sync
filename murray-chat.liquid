{%- comment -%}
  BRBR (formerly Murray): the 705 BRBR chat assistant (chat bubble, bottom right, every page).
  Answers come from the "brbr-murray" Cloudflare Worker (murray-worker/ in the nrs-shopify-sync repo), which uses
  Claude plus the live store catalog. The conversation is kept for the browser tab (sessionStorage) only.
  Turn it off by removing this section or clearing "Assistant API URL". Sizes in px because this theme scales rem down.
{%- endcomment -%}

{%- assign murray_api = section.settings.api_url | strip -%}
{%- assign murray_logo = '' -%}
{%- if section.settings.logo != blank -%}{%- assign murray_logo = section.settings.logo | image_url: width: 160 -%}{%- endif -%}
{%- capture murray_avatar -%}{%- if murray_logo != blank -%}<span class="murray-avatar murray-avatar--logo" aria-hidden="true"><img src="{{ murray_logo }}" alt="" width="80" height="80"></span>{%- else -%}<span class="murray-avatar" aria-hidden="true">M</span>{%- endif -%}{%- endcapture -%}
{%- if murray_api != blank -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap">
<style>
  .murray, .murray * { box-sizing: border-box; }
  .murray {
    --m-brand: #7C3AED; --m-brand-2: #A855F7; --m-brand-dark: #4C1D95; --m-ink: #0F0A1F; --m-text: #1F1B2E;
    --m-muted: #6B6880; --m-line: #ECEAF3; --m-surface: #F6F5FB;
    font-family: "Plus Jakarta Sans", ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
    color: var(--m-text); -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale;
    letter-spacing: 0; word-spacing: 0.08em;
  }

  /* Launcher */
  .murray-launch {
    position: fixed; right: 22px; bottom: 22px; z-index: 1005;
    display: inline-flex; align-items: center; gap: 10px;
    height: 58px; padding: 0 22px 0 8px; border: 0; border-radius: 9999px;
    background: linear-gradient(135deg, #5B21B6 0%, var(--m-brand) 55%, var(--m-brand-2) 100%); color: #FFFFFF;
    font-family: inherit; font-size: 15px; font-weight: 600; letter-spacing: -0.01em; cursor: pointer;
    box-shadow: 0 12px 30px -6px rgba(91, 33, 182, 0.55), inset 0 1px 0 rgba(255, 255, 255, 0.25);
    transition: transform 0.25s cubic-bezier(.2,.8,.2,1), box-shadow 0.25s ease, opacity 0.2s ease;
  }
  .murray-launch::after {
    content: ""; position: absolute; inset: -4px; border-radius: inherit; border: 2px solid rgba(168, 85, 247, 0.45);
    animation: murray-ring 2.8s ease-out infinite; pointer-events: none;
  }
  @keyframes murray-ring { 0% { transform: scale(0.96); opacity: 0.9; } 70%, 100% { transform: scale(1.12); opacity: 0; } }
  .murray-launch:hover { transform: translateY(-3px); box-shadow: 0 18px 36px -8px rgba(91, 33, 182, 0.65), inset 0 1px 0 rgba(255, 255, 255, 0.25); }
  .murray-launch:focus-visible { outline: 3px solid #C4B5FD; outline-offset: 4px; }
  .murray-launch[aria-expanded="true"] { opacity: 0; pointer-events: none; transform: scale(0.85); }
  .murray-launch .murray-dot { position: absolute; left: 40px; top: 8px; width: 13px; height: 13px; border-radius: 50%; background: #22C55E; border: 2.5px solid #FFFFFF; }

  .murray-avatar {
    flex: none; display: inline-flex; align-items: center; justify-content: center;
    width: 42px; height: 42px; border-radius: 50%; background: #FFFFFF; color: var(--m-brand);
    font-size: 18px; font-weight: 700; line-height: 1;
  }
  .murray-avatar--logo { padding: 0; overflow: hidden; background: #2E1065; box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.9); }
  .murray-avatar--logo img { display: block; width: 100%; height: 100%; object-fit: cover; border-radius: 50%; }

  /* Panel */
  .murray-panel {
    position: fixed; right: 22px; bottom: 22px; z-index: 1006;
    width: 400px; height: min(660px, calc(100vh - 110px)); max-height: 700px;
    display: flex; flex-direction: column; overflow: hidden;
    background: var(--m-surface); border-radius: 26px;
    box-shadow: 0 30px 80px -20px rgba(15, 10, 31, 0.45), 0 0 0 1px rgba(15, 10, 31, 0.06);
    opacity: 0; visibility: hidden; transform: translateY(20px) scale(0.97); transform-origin: bottom right;
    transition: opacity 0.22s ease, transform 0.28s cubic-bezier(.2,.8,.2,1), visibility 0s linear 0.28s;
  }
  .murray-panel.is-open { opacity: 1; visibility: visible; transform: none; transition: opacity 0.22s ease, transform 0.28s cubic-bezier(.2,.8,.2,1); }

  .murray-head {
    position: relative; display: flex; align-items: center; gap: 12px; padding: 16px 14px 16px 18px; color: #FFFFFF;
    background:
      radial-gradient(90% 160% at 100% 0%, rgba(168, 85, 247, 0.55) 0%, rgba(168, 85, 247, 0) 60%),
      linear-gradient(135deg, #1E0B3B 0%, #3B1A78 55%, #5B21B6 100%);
  }
  .murray-head-av { position: relative; flex: none; }
  .murray-head-av::after { content: ""; position: absolute; right: 0; bottom: 1px; width: 11px; height: 11px; border-radius: 50%; background: #22C55E; border: 2px solid #2B1258; }
  .murray-head-text { flex: 1; min-width: 0; }
  .murray-head-text strong { display: block; font-size: 16.5px; font-weight: 700; letter-spacing: -0.015em; line-height: 1.2; }
  .murray-head-text span { display: block; margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 12.5px; font-weight: 500; color: rgba(237, 233, 254, 0.8); }
  .murray-icon-btn {
    flex: none; display: inline-flex; align-items: center; justify-content: center;
    width: 36px; height: 36px; border: 0; border-radius: 50%; background: rgba(255, 255, 255, 0.1); color: #FFFFFF; cursor: pointer;
    transition: background-color 0.15s ease;
  }
  .murray-icon-btn:hover { background: rgba(255, 255, 255, 0.2); }
  .murray-icon-btn:focus-visible { outline: 2px solid #FFFFFF; outline-offset: 2px; }
  .murray-icon-btn svg { width: 17px; height: 17px; stroke: currentColor; stroke-width: 2; fill: none; stroke-linecap: round; stroke-linejoin: round; }

  /* Conversation */
  .murray-log { flex: 1; overflow-y: auto; padding: 18px 16px 8px; scroll-behavior: smooth; scrollbar-width: thin; scrollbar-color: #D9D5E8 transparent; }
  .murray-log::-webkit-scrollbar { width: 6px; } .murray-log::-webkit-scrollbar-thumb { background: #D9D5E8; border-radius: 6px; }

  .murray-hero { text-align: center; padding: 14px 8px 18px; animation: murray-in 0.35s ease both; }
  .murray-hero .murray-avatar { width: 64px; height: 64px; font-size: 26px; box-shadow: 0 10px 24px -8px rgba(91, 33, 182, 0.5), 0 0 0 4px #FFFFFF; }
  .murray-hero h3 { margin: 14px 0 6px; font-family: inherit; font-size: 20px; font-weight: 700; letter-spacing: -0.02em; color: var(--m-ink); line-height: 1.25; }
  .murray-hero p { margin: 0 auto; max-width: 310px; font-size: 14.5px; line-height: 1.6; color: var(--m-muted); }

  .murray-msg { display: flex; gap: 8px; margin-bottom: 12px; align-items: flex-end; animation: murray-in 0.28s ease both; }
  @keyframes murray-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  .murray-msg .murray-avatar { width: 28px; height: 28px; font-size: 12px; box-shadow: none; }
  .murray-bubble {
    max-width: 84%; padding: 11px 15px; border-radius: 20px; font-size: 15px; font-weight: 400; line-height: 1.6;
    background: #FFFFFF; color: var(--m-text); border-bottom-left-radius: 6px; overflow-wrap: anywhere;
    box-shadow: 0 1px 2px rgba(15, 10, 31, 0.06), 0 0 0 1px rgba(15, 10, 31, 0.04);
  }
  .murray-bubble p { margin: 0 0 8px; } .murray-bubble p:last-child { margin-bottom: 0; }
  .murray-bubble ul, .murray-bubble ol { margin: 4px 0 8px; padding-left: 18px; }
  .murray-bubble li { margin: 3px 0; padding-left: 2px; }
  .murray-bubble li::marker { color: var(--m-brand); }
  .murray-bubble a { color: var(--m-brand); font-weight: 600; text-decoration: none; border-bottom: 1px solid rgba(124, 58, 237, 0.3); }
  .murray-bubble a:hover { border-bottom-color: var(--m-brand); }
  .murray-bubble strong { font-weight: 650; color: var(--m-ink); }
  .murray-msg--user { justify-content: flex-end; }
  .murray-msg--user .murray-bubble {
    background: linear-gradient(135deg, #6D28D9 0%, var(--m-brand) 60%, #9333EA 100%); color: #FFFFFF; font-weight: 500;
    border-radius: 20px; border-bottom-right-radius: 6px; box-shadow: 0 6px 16px -8px rgba(109, 40, 217, 0.6);
  }
  .murray-msg--error .murray-bubble { background: #FFF5F5; color: #9B1C1C; box-shadow: 0 0 0 1px #FED7D7; }

  .murray-typing { display: inline-flex; gap: 5px; padding: 5px 2px; }
  .murray-typing i { width: 7px; height: 7px; border-radius: 50%; background: #B9A6F5; animation: murray-bounce 1.2s infinite ease-in-out; }
  .murray-typing i:nth-child(2) { animation-delay: 0.15s; } .murray-typing i:nth-child(3) { animation-delay: 0.3s; }
  @keyframes murray-bounce { 0%, 80%, 100% { transform: translateY(0); opacity: 0.45; } 40% { transform: translateY(-5px); opacity: 1; } }

  /* Product cards */
  .murray-cards { display: flex; gap: 10px; overflow-x: auto; padding: 2px 2px 12px 36px; margin: -4px 0 8px; scroll-snap-type: x mandatory; scrollbar-width: none; animation: murray-in 0.3s ease both; }
  .murray-cards::-webkit-scrollbar { display: none; }
  .murray-card {
    position: relative; flex: none; width: 158px; scroll-snap-align: start; display: flex; flex-direction: column;
    padding: 6px; background: #FFFFFF; border-radius: 18px; text-decoration: none; color: var(--m-text);
    box-shadow: 0 1px 2px rgba(15, 10, 31, 0.06), 0 0 0 1px rgba(15, 10, 31, 0.05);
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }
  .murray-card:hover { box-shadow: 0 14px 28px -12px rgba(15, 10, 31, 0.28), 0 0 0 1px rgba(124, 58, 237, 0.25); transform: translateY(-3px); }
  .murray-card-img { height: 112px; display: flex; align-items: center; justify-content: center; background: var(--m-surface); border-radius: 13px; padding: 10px; }
  .murray-card-img img { max-width: 100%; max-height: 100%; object-fit: contain; mix-blend-mode: multiply; }
  .murray-card-body { padding: 9px 6px 4px; display: flex; flex-direction: column; gap: 6px; flex: 1; }
  .murray-card-title { font-size: 12.5px; font-weight: 500; line-height: 1.35; color: var(--m-text); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .murray-card-foot { margin-top: auto; display: flex; align-items: center; justify-content: space-between; gap: 6px; }
  .murray-card-price { font-size: 15px; font-weight: 700; letter-spacing: -0.02em; color: var(--m-ink); }
  .murray-card-cta { display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 50%; background: #F1ECFE; color: var(--m-brand); font-size: 14px; font-weight: 700; transition: background-color 0.15s ease, color 0.15s ease; }
  .murray-card:hover .murray-card-cta { background: var(--m-brand); color: #FFFFFF; }

  /* Quick questions */
  .murray-chips { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; padding: 0 16px 12px; }
  .murray-chips[hidden] { display: none; }
  .murray-chip {
    display: flex; align-items: center; gap: 8px; text-align: left;
    border: 0; background: #FFFFFF; color: var(--m-text); border-radius: 14px;
    padding: 10px 12px; font-family: inherit; font-size: 13px; font-weight: 500; line-height: 1.3; cursor: pointer;
    box-shadow: 0 1px 2px rgba(15, 10, 31, 0.05), 0 0 0 1px rgba(15, 10, 31, 0.05);
    transition: box-shadow 0.15s ease, transform 0.15s ease, color 0.15s ease;
  }
  .murray-chip:last-child:nth-child(odd) { grid-column: 1 / -1; }
  .murray-chip span { flex: none; display: inline-flex; align-items: center; justify-content: center; width: 26px; height: 26px; border-radius: 8px; background: #F1ECFE; font-size: 14px; }
  .murray-chip:hover { color: var(--m-brand); transform: translateY(-1px); box-shadow: 0 6px 14px -8px rgba(91, 33, 182, 0.35), 0 0 0 1px rgba(124, 58, 237, 0.3); }

  /* Composer */
  .murray-form { padding: 10px 14px 6px; background: var(--m-surface); }
  .murray-compose {
    display: flex; align-items: flex-end; gap: 6px; padding: 6px 6px 6px 16px;
    background: #FFFFFF; border-radius: 9999px; box-shadow: 0 1px 2px rgba(15, 10, 31, 0.06), 0 0 0 1px rgba(15, 10, 31, 0.08);
    transition: box-shadow 0.15s ease;
  }
  .murray-compose:focus-within { box-shadow: 0 0 0 1.5px var(--m-brand), 0 0 0 5px rgba(124, 58, 237, 0.14); }
  .murray-input {
    flex: 1; min-height: 40px; max-height: 120px; resize: none; padding: 10px 0; border: 0; background: transparent;
    font: inherit; font-size: 15px; font-weight: 400; line-height: 1.35; color: var(--m-ink); outline: none; box-shadow: none;
  }
  .murray-input::placeholder { color: #9A97AD; }
  .murray-send {
    flex: none; width: 40px; height: 40px; border: 0; border-radius: 50%;
    background: linear-gradient(135deg, #6D28D9 0%, var(--m-brand-2) 100%); color: #FFFFFF; cursor: pointer;
    display: inline-flex; align-items: center; justify-content: center; box-shadow: 0 6px 14px -6px rgba(109, 40, 217, 0.7);
    transition: transform 0.15s ease, opacity 0.15s ease;
  }
  .murray-send:hover { transform: scale(1.06); } .murray-send:disabled { opacity: 0.45; cursor: default; transform: none; }
  .murray-send svg { width: 18px; height: 18px; stroke: currentColor; stroke-width: 2.2; fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .murray-fine { margin: 0; padding: 4px 16px 12px; font-size: 11px; line-height: 1.4; color: #9A97AD; text-align: center; background: var(--m-surface); }

  @media (max-width: 600px) {
    .murray-launch { right: 14px; bottom: 14px; height: 54px; width: 54px; padding: 0; justify-content: center; }
    .murray-launch .murray-label { display: none; }
    .murray-launch .murray-dot { left: 38px; top: 3px; }
    .murray-panel { right: 0; bottom: 0; left: 0; width: 100%; height: 100%; max-height: none; border-radius: 0; }
    .murray-input { font-size: 16px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .murray-panel, .murray-launch, .murray-msg, .murray-hero, .murray-cards { transition: none; animation: none; }
    .murray-launch::after, .murray-typing i { animation: none; }
  }
</style>

<div class="murray" id="murrayChat" data-api="{{ murray_api | escape }}" data-name="{{ section.settings.bot_name | escape }}" data-logo="{{ murray_logo | escape }}">
  <button type="button" class="murray-launch" id="murrayLaunch" aria-controls="murrayPanel" aria-expanded="false" aria-label="Chat with {{ section.settings.bot_name | escape }}, the 705 BRBR assistant">
    {{ murray_avatar }}
    <span class="murray-dot" aria-hidden="true"></span>
    <span class="murray-label">{{ section.settings.launcher_text | escape }}</span>
  </button>

  <section class="murray-panel" id="murrayPanel" role="dialog" aria-modal="false" aria-labelledby="murrayTitle" aria-hidden="true">
    <header class="murray-head">
      <span class="murray-head-av">{{ murray_avatar }}</span>
      <div class="murray-head-text">
        <strong id="murrayTitle">{{ section.settings.bot_name | escape }}</strong>
        <span>Online now · 705 BRBR assistant</span>
      </div>
      <button type="button" class="murray-icon-btn" id="murrayReset" title="Start a new chat" aria-label="Start a new chat">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/></svg>
      </button>
      <button type="button" class="murray-icon-btn" id="murrayClose" title="Close" aria-label="Close chat">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </header>
    <div class="murray-log" id="murrayLog" aria-live="polite"></div>
    <div class="murray-chips" id="murrayChips">
      <button type="button" class="murray-chip" data-q="Are you open now?"><span aria-hidden="true">🕒</span>Are you open now?</button>
      <button type="button" class="murray-chip" data-q="Find me an IPA 6-pack"><span aria-hidden="true">🍺</span>Find an IPA 6&#8209;pack</button>
      <button type="button" class="murray-chip" data-q="Do you deliver?"><span aria-hidden="true">🛵</span>Do you deliver?</button>
      <button type="button" class="murray-chip" data-q="How do I get 10% off?"><span aria-hidden="true">🎁</span>How do I get 10% off?</button>
      <button type="button" class="murray-chip" data-q="What are the latest lottery numbers?"><span aria-hidden="true">🎟️</span>Latest lottery numbers</button>
    </div>
    <form class="murray-form" id="murrayForm">
      <label for="murrayInput" class="visually-hidden" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)">Message {{ section.settings.bot_name | escape }}</label>
      <div class="murray-compose">
        <textarea id="murrayInput" class="murray-input" rows="1" maxlength="1200" placeholder="Ask about products, prices, hours…" autocomplete="off"></textarea>
        <button type="submit" class="murray-send" id="murraySend" aria-label="Send">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5"/><path d="m5 12 7-7 7 7"/></svg>
        </button>
      </div>
    </form>
    <p class="murray-fine">{{ section.settings.bot_name | escape }} is an AI assistant and can make mistakes. Urgent? Call (917) 265-8063.</p>
  </section>
</div>

<script>
  (function () {
    var root = document.getElementById('murrayChat');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    // Live directly under <body> so no header/section stacking context can put page content on top of the chat
    if (root.parentNode !== document.body) document.body.appendChild(root);
    var API = String(root.dataset.api || '').replace(/\/+$/, '');
    var NAME = root.dataset.name || 'BRBR';
    var KEY = 'brbr-murray-chat';
    var LOGO = root.dataset.logo || '';
    var AVATAR = LOGO
      ? '<span class="murray-avatar murray-avatar--logo" aria-hidden="true"><img src="' + LOGO.replace(/"/g, '&quot;') + '" alt=""></span>'
      : '<span class="murray-avatar" aria-hidden="true">M</span>';
    var launch = document.getElementById('murrayLaunch');
    var panel = document.getElementById('murrayPanel');
    var log = document.getElementById('murrayLog');
    var form = document.getElementById('murrayForm');
    var input = document.getElementById('murrayInput');
    var send = document.getElementById('murraySend');
    var chips = document.getElementById('murrayChips');
    var HERO_AVATAR = LOGO
      ? '<span class="murray-avatar murray-avatar--logo" aria-hidden="true"><img src="' + LOGO.replace(/"/g, '&quot;') + '" alt=""></span>'
      : '<span class="murray-avatar" aria-hidden="true">M</span>';
    var HERO = '<div class="murray-hero">' + HERO_AVATAR + '<h3>Hi, I\'m ' + NAME.replace(/[<>&"]/g, '') + ' 👋</h3>' +
      '<p>Your shopping helper at 705 BRBR. Ask me about products and prices, hours, pickup and delivery, the 10% welcome offer or NY Lottery.</p></div>';

    var state = { messages: [] }; // [{role, content, products?}]
    try { var saved = JSON.parse(sessionStorage.getItem(KEY) || 'null'); if (saved && Array.isArray(saved.messages)) state = saved; } catch (e) {}
    function save() { try { sessionStorage.setItem(KEY, JSON.stringify({ messages: state.messages.slice(-30), open: panel.classList.contains('is-open') })); } catch (e) {} }

    function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (m) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m]; }); }
    function safeUrl(u) { return /^https?:\/\//i.test(u) ? u : (u.charAt(0) === '/' ? u : '#'); }
    // Small, safe markdown: paragraphs, - / 1. lists, **bold**, [text](url) and bare links
    function md(text) {
      var out = [], list = null;
      function inline(s) {
        s = esc(s);
        s = s.replace(/\[([^\]]+)\]\(([^)\s]+)\)/g, function (_, t, u) { return '<a href="' + esc(safeUrl(u.replace(/&amp;/g, '&'))) + '" target="_blank" rel="noopener">' + t + '</a>'; });
        s = s.replace(/(^|[\s(])(https?:\/\/[^\s<)]+[^\s<).,!?])/g, function (_, pre, u) { return pre + '<a href="' + u + '" target="_blank" rel="noopener">' + u.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '') + '</a>'; });
        s = s.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
        s = s.replace(/(^|[\s(])\*([^*\n]+)\*(?=[\s.,!?:;)]|$)/g, '$1<strong>$2</strong>');
        return s;
      }
      String(text || '').replace(/[\u00A0\u2007\u2009\u200A\u202F]/g, ' ').replace(/\u2011/g, '-').split(/\n/).forEach(function (line) {
        var t = line.trim(), m;
        if (/^([-*_]\s*){3,}$/.test(t)) return; // horizontal rule
        if (/^\|?\s*:?-{2,}:?\s*(\|\s*:?-{2,}:?\s*)*\|?$/.test(t)) return; // table divider row
        if (/^\|.*\|$/.test(t)) { // table row -> bullet
          var cells = t.slice(1, -1).split('|').map(function (c) { return c.trim(); }).filter(Boolean);
          if (!cells.length) return;
          t = '- ' + cells.join(' · ');
        }
        if ((m = t.match(/^[-*•]\s+(.*)/)) || (m = t.match(/^\d+[.)]\s+(.*)/))) {
          var tag = /^\d/.test(t) ? 'ol' : 'ul';
          if (!list || list.tag !== tag) { if (list) out.push('</' + list.tag + '>'); list = { tag: tag }; out.push('<' + tag + '>'); }
          out.push('<li>' + inline(m[1]) + '</li>');
          return;
        }
        if (list) { out.push('</' + list.tag + '>'); list = null; }
        if (t) out.push('<p>' + inline(t.replace(/^#+\s*/, '')) + '</p>');
      });
      if (list) out.push('</' + list.tag + '>');
      return out.join('');
    }
    function money(n) { return n == null ? '' : '$' + Number(n).toFixed(2); }

    function addBubble(role, html, extraClass) {
      var row = document.createElement('div');
      row.className = 'murray-msg murray-msg--' + role + (extraClass ? ' ' + extraClass : '');
      row.innerHTML = (role === 'user' ? '' : AVATAR) + '<div class="murray-bubble">' + html + '</div>';
      log.appendChild(row);
      return row;
    }
    function addCards(products) {
      if (!products || !products.length) return;
      var wrap = document.createElement('div');
      wrap.className = 'murray-cards';
      wrap.innerHTML = products.map(function (p) {
        return '<a class="murray-card" href="' + esc(safeUrl(p.url || '#')) + '">' +
          '<span class="murray-card-img">' + (p.image ? '<img src="' + esc(p.image) + '" alt="" loading="lazy">' : '') + '</span>' +
          '<span class="murray-card-body"><span class="murray-card-title">' + esc(p.title) + '</span>' +
          '<span class="murray-card-foot"><span class="murray-card-price">' + esc(money(p.price)) + '</span><span class="murray-card-cta" aria-hidden="true">→</span></span></span></a>';
      }).join('');
      log.appendChild(wrap);
    }
    function scrollDown() { log.scrollTop = log.scrollHeight; }

    function renderAll() {
      log.innerHTML = '';
      log.insertAdjacentHTML('beforeend', HERO);
      state.messages.forEach(function (m) {
        if (m.role === 'user') addBubble('user', esc(m.content).replace(/\n/g, '<br>'));
        else { addBubble('bot', md(m.content)); addCards(m.products); }
      });
      chips.hidden = state.messages.length > 0;
      scrollDown();
    }

    function open() {
      panel.classList.add('is-open');
      panel.setAttribute('aria-hidden', 'false');
      launch.setAttribute('aria-expanded', 'true');
      if (!log.children.length) renderAll();
      setTimeout(function () { input.focus(); scrollDown(); }, 60);
      save();
    }
    function close() {
      panel.classList.remove('is-open');
      panel.setAttribute('aria-hidden', 'true');
      launch.setAttribute('aria-expanded', 'false');
      launch.focus();
      save();
    }

    var busy = false;
    function ask(text) {
      text = String(text || '').trim();
      if (!text || busy) return;
      busy = true; send.disabled = true; chips.hidden = true;
      state.messages.push({ role: 'user', content: text });
      addBubble('user', esc(text).replace(/\n/g, '<br>'));
      var typing = addBubble('bot', '<span class="murray-typing" aria-label="' + esc(NAME) + ' is typing"><i></i><i></i><i></i></span>');
      scrollDown(); save();
      var payload = { messages: state.messages.map(function (m) { return { role: m.role, content: m.content }; }), page: location.pathname };
      var ctrl = window.AbortController ? new AbortController() : null;
      var timer = setTimeout(function () { if (ctrl) ctrl.abort(); }, 45000);
      fetch(API + '/chat', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload), signal: ctrl ? ctrl.signal : undefined })
        .then(function (r) { return r.json().catch(function () { return {}; }).then(function (j) { return { ok: r.ok, j: j }; }); })
        .then(function (res) {
          typing.remove();
          if (!res.ok && !res.j.reply) throw new Error(res.j.error || 'error');
          var reply = res.j.reply || '';
          state.messages.push({ role: 'assistant', content: reply, products: res.j.products || [] });
          addBubble('bot', md(reply)); addCards(res.j.products);
        })
        .catch(function (err) {
          typing.remove();
          state.messages.pop(); // let them resend
          addBubble('bot', md("Sorry, I couldn't connect just now. Please try again in a moment, or call the store at (917) 265-8063." + (err && /fast/.test(err.message) ? ' (' + err.message + ')' : '')), 'murray-msg--error');
        })
        .then(function () { clearTimeout(timer); busy = false; send.disabled = false; scrollDown(); save(); input.focus(); });
    }

    launch.addEventListener('click', open);
    document.getElementById('murrayClose').addEventListener('click', close);
    document.getElementById('murrayReset').addEventListener('click', function () { state.messages = []; save(); renderAll(); input.focus(); });
    panel.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
    chips.addEventListener('click', function (e) { var c = e.target.closest('.murray-chip'); if (c) ask(c.dataset.q || c.textContent); });
    form.addEventListener('submit', function (e) { e.preventDefault(); var t = input.value; input.value = ''; input.style.height = ''; ask(t); });
    input.addEventListener('keydown', function (e) { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); form.requestSubmit ? form.requestSubmit() : form.dispatchEvent(new Event('submit')); } });
    input.addEventListener('input', function () { input.style.height = 'auto'; input.style.height = Math.min(input.scrollHeight, 120) + 'px'; });
    // Other parts of the site can open the assistant with a link to #ask-murray or window.BRBRMurray.open()
    window.BRBRMurray = { open: open, ask: function (t) { open(); ask(t); } };
    if (location.hash === '#ask-murray') open();
    try { if (JSON.parse(sessionStorage.getItem(KEY) || '{}').open) open(); } catch (e) {}
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "BRBR Chat Assistant",
  "settings": [
    { "type": "text", "id": "api_url", "label": "Assistant API URL", "default": "https://brbr-murray.munatsialwyn26.workers.dev", "info": "The brbr-murray Cloudflare Worker. Clear this to hide the chat." },
    { "type": "text", "id": "bot_name", "label": "Assistant name", "default": "BRBR" },
    { "type": "image_picker", "id": "logo", "label": "Avatar (store logo)", "info": "Shown on the chat button, in the chat header and next to the assistant's replies." },
    { "type": "text", "id": "launcher_text", "label": "Chat button text", "default": "Ask BRBR" }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
