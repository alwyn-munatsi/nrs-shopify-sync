{%- comment -%}
  705 BRBR "Order again" links from the customer account (My 705 page and order pages).
  A link like /cart?brbr_reorder=123:1,456:2 (variant id : quantity) adds those items to the cart, then shows the
  cart. Items are added through the normal /cart/add.js, so the site's 21+ age check still runs for unverified
  customers. Items that are sold out or no longer sold are skipped with a short note.
{%- endcomment -%}
<script>
  (function () {
    var m = /[?&]brbr_reorder=([^&#]+)/.exec(location.search);
    if (!m) return;
    var raw = decodeURIComponent(m[1]);
    var items = raw.split(',').map(function (p) {
      var a = p.split(':');
      return { id: parseInt(a[0], 10), quantity: Math.max(1, Math.min(99, parseInt(a[1], 10) || 1)) };
    }).filter(function (i) { return i.id > 0; }).slice(0, 40);
    // Remove the parameter so a refresh doesn't add the items twice
    var clean = location.pathname + location.search.replace(/([?&])brbr_reorder=[^&#]*&?/, '$1').replace(/[?&]$/, '') + location.hash;
    try { history.replaceState(null, '', clean); } catch (e) {}
    if (!items.length) return;

    function note(text) {
      try { sessionStorage.setItem('brbr-reorder-note', text); } catch (e) {}
    }
    function addOne(item) {
      return fetch('/cart/add.js', {
        method: 'POST', credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ items: [item] })
      }).then(function (r) { return r.ok; }).catch(function () { return false; });
    }
    // One request for everything; if any item can't be added, add them one by one so the rest still go in.
    fetch('/cart/add.js', {
      method: 'POST', credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify({ items: items })
    }).then(function (r) {
      if (r.ok) return items.length;
      return items.reduce(function (p, it) { return p.then(function (n) { return addOne(it).then(function (ok) { return n + (ok ? 1 : 0); }); }); }, Promise.resolve(0));
    }).then(function (added) {
      if (added < items.length) note(added ? 'Some items are sold out or no longer available, so we added the rest.' : 'Sorry, those items are sold out right now.');
      // The 21+ age check may open now (it watches cart adds); go to the cart once it's done or not needed.
      var go = function () { location.href = '/cart'; };
      setTimeout(function wait() {
        var gate = document.getElementById('brbrAgeGate');
        if (gate && gate.classList.contains('is-open')) return setTimeout(wait, 400);
        go();
      }, 500);
    });
  })();

  // Show the note on the cart page
  (function () {
    var t = null;
    try { t = sessionStorage.getItem('brbr-reorder-note'); } catch (e) {}
    if (!t || !/\/cart\/?$/.test(location.pathname)) return;
    try { sessionStorage.removeItem('brbr-reorder-note'); } catch (e) {}
    document.addEventListener('DOMContentLoaded', function () {
      var main = document.querySelector('main') || document.body;
      var div = document.createElement('div');
      div.setAttribute('role', 'status');
      div.style.cssText = 'max-width:900px;margin:16px auto 0;padding:12px 16px;border-radius:12px;background:#FFFBEB;border:1px solid #FDE68A;color:#92400E;font:600 14px/1.45 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;';
      div.textContent = t;
      main.insertBefore(div, main.firstChild);
    });
  })();
</script>

{% schema %}
{
  "name": "Order Again Links",
  "settings": [],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
