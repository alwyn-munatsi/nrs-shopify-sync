<style>
  #shopify-section-{{ section.id }} {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    width: 100% !important;
    height: 40px !important; /* Bumped from 36px to comfortably fit larger font */
    z-index: 1000 !important;
  }

  .custom-top-bar {
    width: 100%;
    height: 40px;
    background-color: #070B14;
    color: #FFFFFF;
    padding: 0 1.5rem;
    font-size: 0.92rem; /* Scaled from 0.82rem */
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    font-family: var(--font-body-family, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif);
    box-sizing: border-box;
  }

  .custom-top-bar-left {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
  }

  .store-status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 3px 10px;
    border-radius: 9999px;
    font-size: 0.86rem; /* Scaled from 0.74rem */
    font-weight: 700;
    letter-spacing: 0.02em;
    transition: all 0.3s ease;
  }

  .store-status-badge.status-open {
    background: rgba(16, 185, 129, 0.18);
    color: #34D399;
    border: 1px solid rgba(52, 211, 153, 0.4);
  }

  .store-status-badge.status-closed {
    background: rgba(245, 158, 11, 0.18);
    color: #FBBF24;
    border: 1px solid rgba(251, 191, 36, 0.4);
  }

  .status-radar-dot {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: inline-block;
    flex-shrink: 0;
  }

  .status-open .status-radar-dot {
    background-color: #10B981;
  }

  .status-closed .status-radar-dot {
    background-color: #F59E0B;
  }

  .status-radar-dot::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    animation: statusPulse 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  .status-open .status-radar-dot::after {
    background-color: #34D399;
  }

  .status-closed .status-radar-dot::after {
    background-color: #FBBF24;
  }

  @keyframes statusPulse {
    0% {
      transform: translate(-50%, -50%) scale(1);
      opacity: 0.85;
    }
    100% {
      transform: translate(-50%, -50%) scale(2.8);
      opacity: 0;
    }
  }

  .store-hours-text {
    color: #CBD5E1; /* High contrast bright tone */
    font-size: 0.88rem; /* Scaled from 0.76rem */
    font-weight: 500;
  }

  .custom-top-bar-end {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .custom-top-bar-right {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .custom-top-bar-link {
    color: #E2E8F0;
    text-decoration: none;
    font-size: 0.92rem; /* Scaled from 0.82rem */
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: color 0.15s ease;
  }

  .custom-top-bar-link:hover {
    color: #FFFFFF;
  }

  .top-bar-icon {
    width: 15px;
    height: 15px;
    color: #7C3AED;
    flex-shrink: 0;
  }

  /* Social links (from Theme settings > Social media) */
  .top-bar-social {
    order: -1; /* show before the phone number */
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding-right: 1.25rem;
    border-right: 1px solid rgba(255, 255, 255, 0.15);
  }

  .top-bar-social a {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #CBD5E1;
    background: rgba(255, 255, 255, 0.06);
    transition: background 0.15s ease, color 0.15s ease, transform 0.15s ease;
  }

  .top-bar-social a:hover {
    color: #FFFFFF;
    background: #7C3AED;
    transform: translateY(-1px);
  }

  .top-bar-social svg {
    width: 14px;
    height: 14px;
    fill: currentColor;
    display: block;
  }

  .top-bar-social .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .custom-top-bar-link, .store-status-badge { white-space: nowrap; }
  @media (max-width: 1380px) {
    .custom-top-bar-right { gap: 1.25rem; }
    .tb-addr-long { display: none; }
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      height: 36px !important;
    }
    .custom-top-bar {
      height: 36px;
      padding: 0 0.85rem;
    }
    .store-status-badge {
      font-size: 0.82rem;
      padding: 2px 8px;
    }
    .custom-top-bar-right,
    .store-hours-text {
      display: none;
    }
    .top-bar-social {
      padding-right: 0;
      border-right: 0;
      gap: 2px;
    }
    .top-bar-social a {
      width: 24px;
      height: 24px;
      background: transparent;
    }
    .top-bar-social svg {
      width: 13px;
      height: 13px;
    }
  }

  @media (max-width: 860px) {
    .tb-extra { display: none; }
  }
  @media (max-width: 480px) {
    .custom-top-bar { padding: 0 0.6rem; }
  }
</style>

