<script>
  function evaluateStoreAvailability() {
    const badge = document.getElementById('liveStoreStatusBadge');
    const label = document.getElementById('liveStoreStatusText');
    if (!badge || !label) return;

    const options = { timeZone: 'America/New_York', hour12: false, hour: 'numeric', minute: 'numeric' };
    const nyTimeStr = new Intl.DateTimeFormat([], options).format(new Date());
    const parts = nyTimeStr.split(':');
    const hour = parseInt(parts[0], 10);

    const isOpen = hour >= 6 && hour < 24;

    if (isOpen) {
      badge.className = 'store-status-badge status-open';
      label.innerHTML = 'Open Now<span class="tb-extra"> - Daily Hours: 6:00am - 12:00am (Midnight)</span>';
    } else {
      badge.className = 'store-status-badge status-closed';
      label.innerHTML = 'Pre-Order<span class="tb-extra"> - Opens at 6:00am · Daily Hours: 6:00am - 12:00am (Midnight)</span>';
    }
  }

  document.addEventListener('DOMContentLoaded', evaluateStoreAvailability);
  setInterval(evaluateStoreAvailability, 60000);
</script>

