{%- comment -%}
  705 BRBR option pages, linked from the customer account menu (and usable anywhere):
  - Mode "order" (page /pages/order): order on our own website first, then DoorDash, Uber Eats, Grubhub,
    delivery.com, or call to order.
  - Mode "visit" (page /pages/visit-us): address, hours, a map, and buttons for Apple Maps, Google Maps
    and Waze, plus copy address / call. On iPhone and Mac, Apple Maps is shown first.
  Sizes in px because this theme scales rem down.
{%- endcomment -%}

{%- liquid
  assign mode = section.settings.mode
  assign addr = '705 2nd Ave, New York, NY 10016'
-%}

<style>
  .brbr-opt { padding: 40px 16px 56px; background: #F8FAFC; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; box-sizing: border-box; }
  .brbr-opt * { box-sizing: border-box; }
  .brbr-opt__wrap { max-width: 640px; margin: 0 auto; }
  .brbr-opt__head { text-align: center; margin-bottom: 24px; }
  .brbr-opt__tag {
    display: inline-flex; align-items: center; gap: 6px; padding: 5px 12px; border-radius: 9999px; margin-bottom: 10px;
    background: #EDE9FE; border: 1px solid #DDD6FE; color: #7C3AED; font-size: 12px; font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase;
  }
  .brbr-opt__title { margin: 0 0 8px; font-size: 30px; font-weight: 800; line-height: 1.2; letter-spacing: -0.02em; color: #0F172A; }
  .brbr-opt__sub { margin: 0 auto; max-width: 480px; font-size: 15.5px; line-height: 1.55; color: #475569; }

  /* Main (recommended) option */
  .brbr-opt__hero {
    display: flex; align-items: center; gap: 16px; padding: 20px; border-radius: 20px; text-decoration: none; color: #FFFFFF;
    background: radial-gradient(120% 120% at 0% 0%, #7C3AED 0%, #5B21B6 55%, #3B0764 100%);
    box-shadow: 0 18px 40px -18px rgba(91, 33, 182, 0.75); transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .brbr-opt__hero:hover { transform: translateY(-2px); box-shadow: 0 22px 46px -18px rgba(91, 33, 182, 0.85); color: #FFFFFF; }
  .brbr-opt__hero-icon { flex: none; display: inline-flex; align-items: center; justify-content: center; width: 56px; height: 56px; border-radius: 16px; background: rgba(255, 255, 255, 0.16); }
  .brbr-opt__hero-icon img { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; }
  .brbr-opt__hero-icon svg { width: 28px; height: 28px; stroke: currentColor; stroke-width: 2; fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .brbr-opt__hero-body { flex: 1; min-width: 0; }
  .brbr-opt__badge { display: inline-block; margin-bottom: 5px; padding: 2px 8px; border-radius: 6px; background: #FDE047; color: #422006; font-size: 11px; font-weight: 800; letter-spacing: 0.04em; text-transform: uppercase; }
  .brbr-opt__hero-title { display: block; font-size: 19px; font-weight: 800; line-height: 1.25; }
  .brbr-opt__hero-text { display: block; margin-top: 3px; font-size: 14px; line-height: 1.45; color: #EDE9FE; }
  .brbr-opt__arrow { flex: none; width: 22px; height: 22px; stroke: currentColor; stroke-width: 2.4; fill: none; stroke-linecap: round; stroke-linejoin: round; }

  .brbr-opt__label { margin: 26px 2px 10px; font-size: 13px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: #64748B; }
  .brbr-opt__list { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .brbr-opt__item {
    display: flex; align-items: center; gap: 12px; min-height: 64px; padding: 12px 14px; border-radius: 16px; text-decoration: none;
    background: #FFFFFF; border: 1px solid #E2E8F0; color: #0F172A; cursor: pointer; font: inherit; text-align: left; width: 100%;
    transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }
  .brbr-opt__item:hover { border-color: #C4B5FD; transform: translateY(-1px); box-shadow: 0 10px 22px -14px rgba(15, 23, 42, 0.35); color: #0F172A; }
  .brbr-opt__logo { flex: none; display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 12px; font-size: 13px; font-weight: 900; color: #FFFFFF; }
  .brbr-opt__logo svg { width: 20px; height: 20px; stroke: currentColor; stroke-width: 2; fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .brbr-opt__name { display: block; font-size: 15.5px; font-weight: 800; line-height: 1.25; }
  .brbr-opt__note { display: block; margin-top: 2px; font-size: 12.5px; color: #64748B; line-height: 1.35; }
  .brbr-opt__ext { margin-left: auto; flex: none; font-size: 14px; color: #94A3B8; }

  .brbr-opt__info { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 12px; }
  .brbr-opt__card { padding: 14px 16px; border-radius: 16px; background: #FFFFFF; border: 1px solid #E2E8F0; }
  .brbr-opt__card strong { display: block; margin-bottom: 3px; font-size: 12px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: #7C3AED; }
  .brbr-opt__card span { font-size: 15px; line-height: 1.45; color: #0F172A; font-weight: 600; }
  .brbr-opt__map { overflow: hidden; height: 220px; border-radius: 18px; border: 1px solid #E2E8F0; background: #E2E8F0; }
  .brbr-opt__map iframe { display: block; width: 100%; height: 100%; border: 0; }
  .brbr-opt__foot { margin: 22px 0 0; text-align: center; font-size: 14px; color: #64748B; }
  .brbr-opt__foot a { color: #7C3AED; font-weight: 700; text-decoration: none; }
  .brbr-opt__foot a:hover { text-decoration: underline; }

  @media (max-width: 560px) {
    .brbr-opt { padding: 28px 14px 44px; }
    .brbr-opt__title { font-size: 25px; }
    .brbr-opt__list, .brbr-opt__info { grid-template-columns: 1fr; }
    .brbr-opt__hero { padding: 16px; gap: 12px; }
    .brbr-opt__hero-icon { width: 48px; height: 48px; }
  }
</style>

<section class="brbr-opt" id="brbrOpt-{{ section.id }}">
  <div class="brbr-opt__wrap">
    {%- if mode == 'visit' -%}
      <div class="brbr-opt__head">
        <span class="brbr-opt__tag">Visit us</span>
        <h1 class="brbr-opt__title">{{ section.settings.visit_title | escape }}</h1>
        <p class="brbr-opt__sub">{{ section.settings.visit_text | escape }}</p>
      </div>


      <p class="brbr-opt__label" style="margin-top:0">Get directions with</p>
      <div class="brbr-opt__list" data-maps>
        <a class="brbr-opt__item" data-app="apple" href="https://maps.apple.com/?address={{ addr | url_encode }}&q=705+BRBR" target="_blank" rel="noopener">
          <span class="brbr-opt__logo" style="background:#111827" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 22s7-6.2 7-12a7 7 0 0 0-14 0c0 5.8 7 12 7 12z"/><circle cx="12" cy="10" r="2.5"/></svg></span>
          <span><span class="brbr-opt__name">Apple Maps</span><span class="brbr-opt__note">iPhone, iPad &amp; Mac</span></span><span class="brbr-opt__ext" aria-hidden="true">↗</span>
        </a>
        <a class="brbr-opt__item" data-app="google" href="https://www.google.com/maps/dir/?api=1&destination={{ '705 BRBR, 705 2nd Ave, New York, NY 10016' | url_encode }}" target="_blank" rel="noopener">
          <span class="brbr-opt__logo" style="background:#1A73E8" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 22s7-6.2 7-12a7 7 0 0 0-14 0c0 5.8 7 12 7 12z"/><circle cx="12" cy="10" r="2.5"/></svg></span>
          <span><span class="brbr-opt__name">Google Maps</span><span class="brbr-opt__note">Any phone or computer</span></span><span class="brbr-opt__ext" aria-hidden="true">↗</span>
        </a>
        <a class="brbr-opt__item" data-app="waze" href="https://waze.com/ul?q={{ addr | url_encode }}&navigate=yes" target="_blank" rel="noopener">
          <span class="brbr-opt__logo" style="background:#33CCFF" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 11l18-8-8 18-2-8z"/></svg></span>
          <span><span class="brbr-opt__name">Waze</span><span class="brbr-opt__note">Driving directions</span></span><span class="brbr-opt__ext" aria-hidden="true">↗</span>
        </a>
        <button type="button" class="brbr-opt__item" data-copy="{{ addr }}">
          <span class="brbr-opt__logo" style="background:#7C3AED" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"/></svg></span>
          <span><span class="brbr-opt__name" data-copy-label>Copy address</span><span class="brbr-opt__note">Paste it in any app</span></span>
        </button>
      </div>

      <div class="brbr-opt__info" style="margin-top:18px">
        <div class="brbr-opt__card"><strong>Address</strong><span>705 2nd Ave (between E 38th &amp; E 39th St)<br>New York, NY 10016</span></div>
        <div class="brbr-opt__card"><strong>Hours</strong><span>Open daily<br>6:00am - 12:00am (Midnight)</span></div>
      </div>
      <div class="brbr-opt__map">
        <iframe title="Map showing 705 BRBR at 705 2nd Ave" loading="lazy" referrerpolicy="no-referrer-when-downgrade"
          src="https://maps.google.com/maps?q=705%202nd%20Ave,%20New%20York,%20NY%2010016&t=&z=16&ie=UTF8&iwloc=&output=embed"></iframe>
      </div>
      <p class="brbr-opt__foot">Questions before you come? Call <a href="tel:+19172658063">(917) 265-8063</a></p>

    {%- else -%}
      <div class="brbr-opt__head">
        <span class="brbr-opt__tag">Order</span>
        <h1 class="brbr-opt__title">{{ section.settings.order_title | escape }}</h1>
        <p class="brbr-opt__sub">{{ section.settings.order_text | escape }}</p>
      </div>

      <a class="brbr-opt__hero" href="{{ routes.all_products_collection_url }}">
        <span class="brbr-opt__hero-icon" aria-hidden="true">
          {%- if section.settings.logo != blank -%}
            {{ section.settings.logo | image_url: width: 96 | image_tag: alt: '' }}
          {%- else -%}
            <svg viewBox="0 0 24 24"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
          {%- endif -%}
        </span>
        <span class="brbr-opt__hero-body">
          <span class="brbr-opt__badge">Best way to order</span>
          <span class="brbr-opt__hero-title">Order on 705brbr.org</span>
          <span class="brbr-opt__hero-text">{{ section.settings.own_text | escape }}</span>
        </span>
        <svg class="brbr-opt__arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
      </a>

      <p class="brbr-opt__label">Or order through a delivery app</p>
      <div class="brbr-opt__list">
        {%- if section.settings.doordash_url != blank -%}
        <a class="brbr-opt__item" href="{{ section.settings.doordash_url }}" target="_blank" rel="noopener">
          <span class="brbr-opt__logo" style="background:#EB1700" aria-hidden="true">DD</span>
          <span><span class="brbr-opt__name">DoorDash</span><span class="brbr-opt__note">Delivery</span></span><span class="brbr-opt__ext" aria-hidden="true">↗</span>
        </a>
        {%- endif -%}
        {%- if section.settings.ubereats_url != blank -%}
        <a class="brbr-opt__item" href="{{ section.settings.ubereats_url }}" target="_blank" rel="noopener">
          <span class="brbr-opt__logo" style="background:#06C167" aria-hidden="true">UE</span>
          <span><span class="brbr-opt__name">Uber Eats</span><span class="brbr-opt__note">Delivery</span></span><span class="brbr-opt__ext" aria-hidden="true">↗</span>
        </a>
        {%- endif -%}
        {%- if section.settings.grubhub_url != blank -%}
        <a class="brbr-opt__item" href="{{ section.settings.grubhub_url }}" target="_blank" rel="noopener">
          <span class="brbr-opt__logo" style="background:#FF8000" aria-hidden="true">GH</span>
          <span><span class="brbr-opt__name">Grubhub</span><span class="brbr-opt__note">Delivery</span></span><span class="brbr-opt__ext" aria-hidden="true">↗</span>
        </a>
        {%- endif -%}
        {%- if section.settings.deliverycom_url != blank -%}
        <a class="brbr-opt__item" href="{{ section.settings.deliverycom_url }}" target="_blank" rel="noopener">
          <span class="brbr-opt__logo" style="background:#1A73E8" aria-hidden="true">D.</span>
          <span><span class="brbr-opt__name">delivery.com</span><span class="brbr-opt__note">Delivery</span></span><span class="brbr-opt__ext" aria-hidden="true">↗</span>
        </a>
        {%- endif -%}
      </div>
      <p class="brbr-opt__foot">Prefer to talk to us? Call <a href="tel:+19172658063">(917) 265-8063</a> · Open daily 6:00am - 12:00am</p>
    {%- endif -%}
  </div>
</section>

{%- if mode == 'visit' -%}
<script>
  (function () {
    var root = document.getElementById('brbrOpt-{{ section.id }}');
    if (!root) return;
    // iPhone, iPad and Mac: show Apple Maps first; everyone else: Google Maps first
    var list = root.querySelector('[data-maps]');
    var apple = /iPhone|iPad|iPod|Macintosh/.test(navigator.userAgent);
    if (list && !apple) list.insertBefore(list.querySelector('[data-app="google"]'), list.firstChild);
    root.addEventListener('click', function (e) {
      var b = e.target.closest('[data-copy]');
      if (!b) return;
      var label = b.querySelector('[data-copy-label]'), text = b.getAttribute('data-copy');
      var done = function () { label.textContent = 'Address copied ✓'; setTimeout(function () { label.textContent = 'Copy address'; }, 2000); };
      if (navigator.clipboard) navigator.clipboard.writeText(text).then(done, function () { label.textContent = text; });
      else label.textContent = text;
    });
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Order & Visit Options",
  "settings": [
    { "type": "select", "id": "mode", "label": "Page type", "default": "order", "options": [
      { "value": "order", "label": "Order options" },
      { "value": "visit", "label": "Visit us / directions" }
    ] },
    { "type": "header", "content": "Order options" },
    { "type": "text", "id": "order_title", "label": "Heading", "default": "How would you like to order?" },
    { "type": "text", "id": "order_text", "label": "Text", "default": "Order straight from us for pickup or delivery, or use your favorite delivery app." },
    { "type": "image_picker", "id": "logo", "label": "Logo on the main option" },
    { "type": "text", "id": "own_text", "label": "Main option text", "default": "Pickup or delivery straight from our store. New customers get 10% off their first order." },
    { "type": "text", "id": "doordash_url", "label": "DoorDash link", "default": "https://www.doordash.com/store/705-brbr-new-york-26214688/" },
    { "type": "text", "id": "ubereats_url", "label": "Uber Eats link", "default": "https://www.ubereats.com/store/705-brbr-705-2nd-avenue/8D1S_353X-G_0TRsvhGytw" },
    { "type": "text", "id": "grubhub_url", "label": "Grubhub link", "default": "https://www.grubhub.com/restaurant/705-brbr-inc-705-2nd-ave-new-york/26214688" },
    { "type": "text", "id": "deliverycom_url", "label": "delivery.com link", "default": "https://www.order.com/glue/705-BRBR-menu/4801" },
    { "type": "header", "content": "Visit us" },
    { "type": "text", "id": "visit_title", "label": "Heading", "default": "Come see us on 2nd Avenue" },
    { "type": "text", "id": "visit_text", "label": "Text", "default": "We're at 705 2nd Ave, between E 38th & E 39th St. Pick the maps app you use for directions." }
  ],
  "presets": [{ "name": "Order & Visit Options" }]
}
{% endschema %}
